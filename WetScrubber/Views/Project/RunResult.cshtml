@model WetScrubber.Business.Flowsheet.FlowsheetTopologicalSolver.SolveOutput
@using System.Linq
@{
    var flowsheet = ViewBag.Flowsheet as WetScrubber.Database.FlowsheetEntity;
    var feedPorts = ViewBag.Feed as WetScrubber.Business.Flowsheet.FlowsheetPorts;
    var feed = feedPorts?.Gas;
    ViewData["Title"] = "Run Result";
    ViewData["ActivePage"] = "Flowsheets";
    var pollutantCodes = feed?.PollutantPpmByCode.Keys.ToList() ?? new List<string>();
}
@section Styles {
    <link rel="stylesheet" href="~/css/project.css" />
    <link rel="stylesheet" href="~/css/flowsheet.css" asp-append-version="true" />
}

<div class="flowsheet-page">
    <div class="breadcrumb">
        <a asp-action="Index">Flowsheets</a>
        <svg viewBox="0 0 16 16" width="12" height="12"><path d="M6 4l4 4-4 4" stroke="#ccc" stroke-width="1.5" fill="none" stroke-linecap="round" /></svg>
        <a asp-action="Detail" asp-route-id="@flowsheet?.Id">@flowsheet?.Name</a>
        <svg viewBox="0 0 16 16" width="12" height="12"><path d="M6 4l4 4-4 4" stroke="#ccc" stroke-width="1.5" fill="none" stroke-linecap="round" /></svg>
        <span>Run Result</span>
    </div>

    <div class="chem-intro-card">
        <div>
            <div class="chem-intro-title">
                @(Model.TearConverged ? "Converged" : "Did not converge")

                @if (Model.TearIterations > 1)
                {
                    <span>— @Model.TearIterations tear iterations</span>
                }
            </div>

            <div class="chem-intro-desc">
                Feed: @feed?.ActualFlowM3Hr m³/hr at @feed?.TemperatureC °C, @feed?.PressurePa Pa
            </div>
        </div>
    </div>

    @if (feed != null && pollutantCodes.Count > 0 && Model.UnitOutlets.Count > 0)
    {
        var lastOut = Model.UnitOutlets.Last().Value.Gas;
        <div class="proj-table-card">
            <div class="proj-table-header">
                <div class="proj-table-title">What This Means</div>
            </div>
            <div class="chem-intro-desc" style="padding:0 20px 18px;">
                <div style="font-size:12.5px;color:#666;margin-bottom:10px;">Compares the dirty gas going in with the gas leaving your last machine.</div>
                @foreach (var code in pollutantCodes)
                {
                    var inPpm = feed.PollutantPpmByCode.TryGetValue(code, out var a) ? a : 0.0;
                    var outPpm = lastOut.PollutantPpmByCode.TryGetValue(code, out var b) ? b : 0.0;
                    var removal = inPpm > 0 ? (1 - outPpm / inPpm) * 100.0 : 0.0;
                    var color = removal >= 90 ? "#00a870" : (removal >= 70 ? "#d98a00" : "#c0392b");
                    var verdict = removal >= 90 ? "Excellent removal." : (removal >= 70 ? "Acceptable, but could be improved. Try a taller tower or more liquid flow." : "Low removal. Increase tower height, packing area or liquid flow, then run again.");
                    <div style="display:flex;align-items:center;gap:14px;padding:10px 0;border-top:1px solid #eee;">
                        <div style="flex:0 0 150px;font-weight:700;color:#0b1120;">@code</div>
                        <div style="flex:1;">
                            <div style="height:10px;background:#eee;border-radius:5px;overflow:hidden;">
                                <div style="height:100%;width:@(Math.Max(0, Math.Min(100, removal)).ToString("F0"))%;background:@color;"></div>
                            </div>
                            <div style="font-size:12.5px;margin-top:5px;color:#333;">
                                @inPpm.ToString("F1") ppm in, @outPpm.ToString("F1") ppm out:
                                <strong style="color:@color;">@removal.ToString("F1")% removed.</strong> @verdict
                            </div>
                        </div>
                    </div>
                }
                <div style="font-size:12px;color:#777;margin-top:8px;">
                    @(Model.TearConverged ? "The calculation settled on a stable answer." : "The calculation did not settle. Treat these numbers with caution and check your recycle settings.")
                </div>
            </div>
        </div>
    }

    <div class="proj-table-card">
        <div class="proj-table-header">
            <div class="proj-table-title">Stage-by-Stage Outlet Streams</div>
        </div>

        <div style="overflow-x:auto;">
            <table class="proj-table">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th>Gas Flow (m³/hr)</th>
                        <th>Gas Temp (°C)</th>
                        <th>Pressure (Pa)</th>

                        @foreach (var code in pollutantCodes)
                        {
                            <th>@code (ppm)</th>
                        }

                        <th>Liquid Flow (kg/s)</th>
                        <th>Liquid Temp (°C)</th>

                        @foreach (var code in pollutantCodes)
                        {
                            <th>@code liquid (mg/kg)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kv in Model.UnitOutlets)
                    {
                        <tr>
                            <td><span class="proj-name">@kv.Key</span></td>
                            <td>@kv.Value.Gas.ActualFlowM3Hr.ToString("F0")</td>
                            <td>@kv.Value.Gas.TemperatureC.ToString("F1")</td>
                            <td>@kv.Value.Gas.PressurePa.ToString("F0")</td>

                            @foreach (var code in pollutantCodes)
                            {
                                <td>@(kv.Value.Gas.PollutantPpmByCode.TryGetValue(code, out var v) ? v.ToString("F1") : "—")</td>
                            }

                            <td>@kv.Value.Liquid.MassFlowKgS.ToString("F1")</td>
                            <td>@kv.Value.Liquid.TemperatureC.ToString("F1")</td>

                            @foreach (var code in pollutantCodes)
                            {
                                <td>@(kv.Value.Liquid.PollutantLoadingKgKg.TryGetValue(code, out var lv) ? (lv * 1e6).ToString("F1") : "—")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div>
        <a asp-action="Detail" asp-route-id="@flowsheet?.Id" class="btn-cancel">
            Back to Flowsheet
        </a>
    </div>
</div>