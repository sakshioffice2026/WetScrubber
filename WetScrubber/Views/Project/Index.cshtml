@using WetScrubber.Database.Enums
@model WetScrubber.Models.ProjectListViewModel

@{
    ViewData["Title"]      = "Projects";
    ViewData["ActivePage"] = "Projects";
}

@section Styles {
    <link rel="stylesheet" href="~/css/project.css" />
}

@section TopbarActions {
    <a asp-controller="Project" asp-action="Create" class="btn-new">
        <svg viewBox="0 0 16 16"><path d="M8 1v14M1 8h14" stroke="#0b1120" stroke-width="2" fill="none"/></svg>
        New Project
    </a>
}

<!-- Stats cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon green">
            <svg viewBox="0 0 16 16"><path d="M2 3a1 1 0 011-1h10a1 1 0 011 1v10a1 1 0 01-1 1H3a1 1 0 01-1-1V3zm2 2v2h8V5H4zm0 4v2h5V9H4z"/></svg>
        </div>
        <div class="stat-info">
            <div class="stat-val">@Model.TotalProjects</div>
            <div class="stat-lbl">Total Projects</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon amber">
            <svg viewBox="0 0 16 16"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm1 4H7v4l3.5 2.1.7-1.2L8 8.5V5z"/></svg>
        </div>
        <div class="stat-info">
            <div class="stat-val">@Model.ActiveProjects</div>
            <div class="stat-lbl">In Progress</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue">
            <svg viewBox="0 0 16 16"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm3.5 5.5l-4 4-2-2 1-1 1 1 3-3 1 1z"/></svg>
        </div>
        <div class="stat-info">
            <div class="stat-val">@Model.CompletedProjects</div>
            <div class="stat-lbl">Completed</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon purple">
            <svg viewBox="0 0 16 16"><path d="M3 2h10a1 1 0 011 1v10a1 1 0 01-1 1H3a1 1 0 01-1-1V3a1 1 0 011-1zm1 2v8h8V4H4z"/></svg>
        </div>
        <div class="stat-info">
            <div class="stat-val">@Model.TotalDesigns</div>
            <div class="stat-lbl">Total Designs</div>
        </div>
    </div>
</div>

<!-- Toolbar -->
<form asp-action="Index" asp-controller="Project" method="get" id="filterForm">
    <div class="proj-toolbar">
        <div class="search-wrap">
            <svg viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 10-1.397 1.398l3.85 3.85a1 1 0 001.415-1.414l-3.868-3.834zm-5.242.656a5 5 0 110-10 5 5 0 010 10z" /></svg>
            <input type="text" name="search" id="liveSearch" class="search-input"
                   placeholder="Search by name, number or client…"
                   value="@Model.SearchTerm" />
        </div>
        <select name="status" id="statusFilter" class="filter-select">
            <option value="">All Status</option>
            @{
                var sf = Model.StatusFilter ?? "";
            }
            <option value="Draft" selected="@(sf == "Draft" ? "selected" : null)">Draft</option>
            <option value="InProgress" selected="@(sf == "InProgress" ? "selected" : null)">In Progress</option>
            <option value="Completed" selected="@(sf == "Completed" ? "selected" : null)">Completed</option>
            <option value="Archived" selected="@(sf == "Archived" ? "selected" : null)">Archived</option>
        </select>
    </div>
</form>

<!-- Table card -->
<div class="proj-table-card">
    <div class="proj-table-header">
        <div class="proj-table-title">All Projects</div>
        <div class="proj-table-count"><span id="visibleCount">@Model.Projects.Count</span> projects</div>
    </div>

    @if (Model.Projects.Any())
    {
        <div style="overflow-x:auto;">
            <table class="proj-table">
                <thead>
                    <tr>
                        <th>Project #</th>
                        <th>Name</th>
                        <th>Client</th>
                        <th>Engineer</th>
                        <th style="text-align:center;">Designs</th>
                        <th>Status</th>
                        <th>Updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Projects)
                    {
                        string badgeClass, statusLabel;
                        if      (p.Status == ProjectStatus.Completed)  { badgeClass = "badge-completed";  statusLabel = "Completed"; }
                        else if (p.Status == ProjectStatus.InProgress) { badgeClass = "badge-inprogress"; statusLabel = "In Progress"; }
                        else if (p.Status == ProjectStatus.Archived)   { badgeClass = "badge-archived";   statusLabel = "Archived"; }
                        else                                            { badgeClass = "badge-draft";      statusLabel = "Draft"; }

                        <tr data-href="/Project/Detail/@p.ProjectId">
                            <td><span class="proj-number">@p.ProjectNumber</span></td>
                            <td><span class="proj-name">@p.ProjectName</span></td>
                            <td><span class="proj-client">@p.ClientName</span></td>
                            <td style="color:#888;">@p.EngineerName</td>
                            <td style="text-align:center;"><span class="design-count">@p.DesignCount</span></td>
                            <td><span class="status-badge @badgeClass">@statusLabel</span></td>
                            <td class="proj-date">@p.UpdatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="action-btns">
                                    <a asp-controller="Project" asp-action="Detail" asp-route-id="@p.ProjectId" class="action-btn" title="View">
                                        <svg viewBox="0 0 16 16"><path d="M8 3C4.5 3 1.5 5.5 1 8c.5 2.5 3.5 5 7 5s6.5-2.5 7-5c-.5-2.5-3.5-5-7-5zm0 8a3 3 0 110-6 3 3 0 010 6zm0-4.5a1.5 1.5 0 100 3 1.5 1.5 0 000-3z"/></svg>
                                    </a>
                                    <a asp-controller="Project" asp-action="Edit" asp-route-id="@p.ProjectId"
                                       class="action-btn" title="Edit project">
                                        <svg viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 01.708 0l3 3a.5.5 0 010 .708l-10 10a.5.5 0 01-.168.11l-5 2a.5.5 0 01-.65-.65l2-5a.5.5 0 01.11-.168l10-10z" /></svg>
                                    </a>
                                    <button type="button" class="action-btn delete btn-open-delete"
                                            data-id="@p.ProjectId" data-name="@p.ProjectName" title="Delete">
                                        <svg viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 016 6v6a.5.5 0 01-1 0V6a.5.5 0 01.5-.5zm2.5 0a.5.5 0 01.5.5v6a.5.5 0 01-1 0V6a.5.5 0 01.5-.5zm3 .5a.5.5 0 00-1 0v6a.5.5 0 001 0V6zM14.5 3a1 1 0 01-1 1H13v9a2 2 0 01-2 2H5a2 2 0 01-2-2V4h-.5a1 1 0 010-2h4a1 1 0 011-1h2a1 1 0 011 1h4a1 1 0 011 1z"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">
                <svg viewBox="0 0 16 16"><path d="M2 3a1 1 0 011-1h10a1 1 0 011 1v10a1 1 0 01-1 1H3a1 1 0 01-1-1V3zm2 2v2h8V5H4zm0 4v2h5V9H4z"/></svg>
            </div>
            <h4>No projects found</h4>
            <p>@(string.IsNullOrEmpty(Model.SearchTerm) ? "Create your first wet scrubber project to get started." : $"No results for \"{Model.SearchTerm}\".")</p>
            @if (string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-controller="Project" asp-action="Create" class="btn-new" style="display:inline-flex;">+ New Project</a>
            }
        </div>
    }
</div>

<!-- Delete confirm modal -->
<div class="modal-backdrop" id="deleteModal">
    <div class="modal-box">
        <div class="modal-icon">
            <svg viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 016 6v6a.5.5 0 01-1 0V6a.5.5 0 01.5-.5zm2.5 0a.5.5 0 01.5.5v6a.5.5 0 01-1 0V6a.5.5 0 01.5-.5zm3 .5a.5.5 0 00-1 0v6a.5.5 0 001 0V6z"/></svg>
        </div>
        <div class="modal-title">Delete Project</div>
        <div class="modal-message">
            Are you sure you want to delete <strong id="deleteProjectName"></strong>?
            All designs inside it will also be permanently deleted.
        </div>
        <div class="modal-actions">
            <button type="button" class="btn-modal-cancel" id="btnModalCancel">Cancel</button>
            <button type="button" class="btn-modal-delete" id="btnModalDelete">Delete Project</button>
        </div>
    </div>
</div>

<form id="deleteForm" asp-controller="Project" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteProjectIdInput" name="id" />
</form>

@section Scripts {
    <script src="~/js/project.js"></script>
}
