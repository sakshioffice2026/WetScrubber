@using WetScrubber.Database.Enums
@model WetScrubber.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";

    int pipeTotal = Model.DraftCount + Model.UnderReviewCount + Model.ChangesRequestedCount + Model.ApprovedCount;
    int needsAction = Model.ChangesRequestedCount + Model.UnderReviewCount;
    int approvalRate = pipeTotal > 0 ? (int)Math.Round(Model.ApprovedCount * 100.0 / pipeTotal) : 0;
    int weekDelta = Model.DesignsThisWeek - Model.DesignsLastWeek;

    string Pct(int n) => pipeTotal > 0 ? (n * 100.0 / pipeTotal).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "0";

    string Ago(DateTime dt)
    {
        var span = DateTime.UtcNow - dt.ToUniversalTime();
        if (span.TotalMinutes < 60) return Math.Max(1, (int)span.TotalMinutes) + " min ago";
        if (span.TotalHours < 24) return (int)span.TotalHours + " h ago";
        if (span.TotalDays < 30) return (int)span.TotalDays + " d ago";
        return dt.ToString("dd MMM yyyy");
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/project.css" />
}

@section TopbarActions {
    <a asp-controller="Project" asp-action="Create" class="btn-new">
        <svg viewBox="0 0 16 16" width="13" height="13">
            <path d="M8 1v14M1 8h14" stroke="#0b1120" stroke-width="2" fill="none" />
        </svg>
        New Project
    </a>
}

<style>
    .dx { --ink:#0f172a; --muted:#64748b; --line:rgba(100,116,139,.22); --accent:#00d28c; }
    .dx * { box-sizing: border-box; }
    .dx-card { background:#fff; border:1px solid var(--line); border-radius:16px; padding:20px 22px; }
    .dx-title { font-size:.95rem; font-weight:700; color:var(--ink); }
    .dx-sub { font-size:.78rem; color:var(--muted); margin-top:2px; }
    .dx-head { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:14px; gap:10px; }
    .dx-grid2 { display:grid; grid-template-columns:1.05fr 1fr; gap:16px; margin-bottom:16px; }
    .dx-grid2.rev { grid-template-columns:1.35fr 1fr; }
    .dx-empty { text-align:center; color:var(--muted); font-size:.85rem; padding:34px 10px; }

    /* hero */
    .dx-hero {
        display:flex; justify-content:space-between; align-items:center; gap:18px; flex-wrap:wrap;
        padding:24px 26px; border-radius:18px; margin-bottom:16px; color:#e2f8ef;
        background: radial-gradient(1200px 300px at 85% -40%, rgba(0,210,140,.35), transparent 60%), linear-gradient(120deg,#0b1730,#0f2a3d);
    }
    .dx-hero h3 { margin:0 0 6px; font-size:1.45rem; color:#fff; }
    .dx-hero p { margin:0; opacity:.82; font-size:.92rem; }
    .dx-hero b { color:#6ff2c4; }
    .dx-actions { display:flex; gap:10px; flex-wrap:wrap; }
    .dx-btn {
        display:inline-flex; align-items:center; gap:8px; padding:10px 16px; border-radius:11px; font-size:.86rem; font-weight:600;
        text-decoration:none; border:1px solid rgba(255,255,255,.25); color:#fff; background:rgba(255,255,255,.08); transition:all .15s;
    }
    .dx-btn:hover { background:rgba(255,255,255,.18); transform:translateY(-1px); }
    .dx-btn.primary { background:var(--accent); border-color:var(--accent); color:#04281c; }
    .dx-btn.primary:hover { background:#27e0a4; }

    /* stat tiles */
    .dx-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:16px; }
    .dx-stat { padding:16px 18px; }
    .dx-stat .lbl { font-size:.7rem; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
    .dx-stat .val { font-size:1.9rem; font-weight:800; color:var(--ink); line-height:1.15; margin-top:4px; }
    .dx-chip { display:inline-block; margin-top:6px; font-size:.72rem; font-weight:600; padding:2px 8px; border-radius:999px; background:#eef2f6; color:var(--muted); }
    .dx-chip.up { background:#dcfce9; color:#047857; }
    .dx-chip.down { background:#fee2e2; color:#b91c1c; }

    /* pipeline */
    .dx-pipe { display:grid; grid-template-columns:repeat(4,1fr); gap:0; margin-bottom:14px; }
    .dx-stage { position:relative; padding:12px 16px 12px 22px; border-top:3px solid var(--c); }
    .dx-stage:not(:last-child)::after {
        content:""; position:absolute; right:-9px; top:-3px; width:18px; height:18px; z-index:2;
        background:#fff; border-top:3px solid var(--c); border-right:3px solid var(--c); transform:rotate(45deg) scale(.55); transform-origin:center;
    }
    .dx-stage .n { font-size:1.6rem; font-weight:800; color:var(--ink); }
    .dx-stage .t { font-size:.78rem; color:var(--muted); }
    .dx-bar { display:flex; height:10px; border-radius:999px; overflow:hidden; background:#eef2f6; }
    .dx-bar span { display:block; height:100%; transition:width .4s; }
    .dx-pipe-foot { display:flex; justify-content:space-between; font-size:.78rem; color:var(--muted); margin-top:8px; }

    /* attention queue */
    .dx-q { display:flex; flex-direction:column; gap:10px; }
    .dx-qi {
        display:grid; grid-template-columns:4px 1fr auto; gap:12px; align-items:center; padding:11px 14px 11px 0;
        border:1px solid var(--line); border-radius:12px; text-decoration:none; color:inherit; background:#fff; overflow:hidden; transition:all .15s;
    }
    .dx-qi:hover { border-color:var(--accent); box-shadow:0 6px 16px rgba(15,23,42,.07); transform:translateY(-1px); }
    .dx-qi .rail { align-self:stretch; background:var(--c); }
    .dx-qi .nm { font-weight:600; font-size:.9rem; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .dx-qi .why { font-size:.78rem; color:var(--muted); margin-top:2px; }
    .dx-qi .why b { color:var(--c); font-weight:700; }
    .dx-qi .go { font-size:.78rem; font-weight:700; color:var(--c); white-space:nowrap; }
    .dx-qi .body { min-width:0; }

    /* heatmap + waffle + envelope */
    .dx-svg { width:100%; height:auto; display:block; }
    .dx-legend { display:flex; flex-wrap:wrap; gap:6px 14px; margin-top:10px; font-size:.76rem; color:var(--muted); }
    .dx-legend i { display:inline-block; width:10px; height:10px; border-radius:3px; margin-right:6px; vertical-align:-1px; }
    .dx-scale { display:flex; align-items:center; gap:4px; font-size:.7rem; color:var(--muted); margin-top:8px; justify-content:flex-end; }
    .dx-scale i { width:12px; height:12px; border-radius:3px; display:inline-block; }
    .dx-waffle { display:grid; grid-template-columns:repeat(10,1fr); gap:4px; max-width:260px; }
    .dx-waffle i { display:block; aspect-ratio:1; border-radius:4px; background:#eef2f6; transition:transform .12s; }
    .dx-waffle i:hover { transform:scale(1.18); }
    .dx-mix { display:flex; gap:22px; align-items:flex-start; flex-wrap:wrap; }
    .dx-mixlist { flex:1; min-width:150px; display:flex; flex-direction:column; gap:8px; }
    .dx-mixrow { display:flex; align-items:center; gap:8px; font-size:.82rem; color:var(--ink); }
    .dx-mixrow i { width:10px; height:10px; border-radius:3px; flex:none; }
    .dx-mixrow span:last-child { margin-left:auto; color:var(--muted); font-variant-numeric:tabular-nums; }

    /* recent project cards */
    .dx-recent { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:14px; }
    .dx-pc { display:block; padding:16px; border:1px solid var(--line); border-radius:14px; text-decoration:none; color:inherit; background:#fff; transition:all .15s; }
    .dx-pc:hover { border-color:var(--accent); box-shadow:0 8px 20px rgba(15,23,42,.08); transform:translateY(-2px); }
    .dx-pc .num { font-size:.72rem; color:var(--muted); }
    .dx-pc .nm { font-weight:700; color:var(--ink); margin:3px 0 2px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:2.6em; }
    .dx-pc .cl { font-size:.8rem; color:var(--muted); margin-bottom:12px; }
    .dx-prog { height:6px; border-radius:999px; background:#eef2f6; overflow:hidden; }
    .dx-prog span { display:block; height:100%; background:var(--accent); border-radius:999px; }
    .dx-pc .meta { display:flex; justify-content:space-between; font-size:.74rem; color:var(--muted); margin-top:7px; }

    #dx-tip {
        position:fixed; z-index:9999; pointer-events:none; opacity:0; transition:opacity .1s; background:#0f172a; color:#fff;
        padding:8px 11px; border-radius:9px; font-size:.78rem; line-height:1.4; max-width:260px; box-shadow:0 8px 24px rgba(0,0,0,.25);
    }

    @@media (max-width: 1100px) {
        .dx-grid2, .dx-grid2.rev { grid-template-columns:1fr; }
        .dx-stats { grid-template-columns:repeat(2,1fr); }
    }
    @@media (max-width: 640px) {
        .dx-pipe { grid-template-columns:repeat(2,1fr); }
        .dx-stage::after { display:none; }
    }
</style>

<div class="dx">

    <!-- HERO -->
    <div class="dx-hero">
        <div>
            <h3>@greeting, @Model.UserFullName.Split(' ').First()</h3>
            <p>
                @if (needsAction > 0)
                {
                    <text><b>@needsAction</b> design@(needsAction == 1 ? "" : "s") need@(needsAction == 1 ? "s" : "") your attention</text>
                    if (Model.ChangesRequestedCount > 0)
                    {
                        <text> &middot; <b>@Model.ChangesRequestedCount</b> with changes requested</text>
                    }
                }
                else
                {
                    <text>You're all caught up &mdash; nothing is waiting on you.</text>
                }
                &middot; Last login @Model.LastLoginAt.ToLocalTime().ToString("dd MMM, hh:mm tt")
            </p>
        </div>
        <div class="dx-actions">
            <a class="dx-btn primary" asp-controller="Scrubber" asp-action="New">+ New Design</a>
            <a class="dx-btn" asp-controller="Flowsheet" asp-action="Index">Flowsheets</a>
            <a class="dx-btn" asp-controller="Report" asp-action="Index">Reports</a>
        </div>
    </div>

    <!-- STAT TILES -->
    <div class="dx-stats">
        <div class="dx-card dx-stat">
            <div class="lbl">Projects</div>
            <div class="val">@Model.TotalProjects</div>
            <span class="dx-chip">@Model.ActiveProjects in progress</span>
        </div>
        <div class="dx-card dx-stat">
            <div class="lbl">Designs</div>
            <div class="val">@Model.TotalDesigns</div>
            <span class="dx-chip @(weekDelta > 0 ? "up" : weekDelta < 0 ? "down" : "")">
                @(weekDelta > 0 ? "▲ " + weekDelta : weekDelta < 0 ? "▼ " + Math.Abs(weekDelta) : "—") vs last week
            </span>
        </div>
        <div class="dx-card dx-stat">
            <div class="lbl">Flowsheets</div>
            <div class="val">@Model.FlowsheetCount</div>
            <span class="dx-chip">Process simulations</span>
        </div>
        <div class="dx-card dx-stat">
            <div class="lbl">Sign-off rate</div>
            <div class="val">@approvalRate%</div>
            <span class="dx-chip @(approvalRate >= 50 ? "up" : "")">@Model.ApprovedCount of @pipeTotal approved</span>
        </div>
    </div>

    <!-- REVIEW PIPELINE -->
    <div class="dx-card" style="margin-bottom:16px;">
        <div class="dx-head">
            <div>
                <div class="dx-title">Design review pipeline</div>
                <div class="dx-sub">Where every design sits on the road to PE sign-off</div>
            </div>
        </div>
        <div class="dx-pipe">
            <div class="dx-stage" style="--c:#94a3b8;"><div class="n">@Model.DraftCount</div><div class="t">Draft</div></div>
            <div class="dx-stage" style="--c:#3b82f6;"><div class="n">@Model.UnderReviewCount</div><div class="t">Under review</div></div>
            <div class="dx-stage" style="--c:#f59e0b;"><div class="n">@Model.ChangesRequestedCount</div><div class="t">Changes requested</div></div>
            <div class="dx-stage" style="--c:#00d28c;"><div class="n">@Model.ApprovedCount</div><div class="t">Approved &amp; locked</div></div>
        </div>
        <div class="dx-bar">
            <span style="width:@Pct(Model.DraftCount)%;background:#94a3b8;"></span>
            <span style="width:@Pct(Model.UnderReviewCount)%;background:#3b82f6;"></span>
            <span style="width:@Pct(Model.ChangesRequestedCount)%;background:#f59e0b;"></span>
            <span style="width:@Pct(Model.ApprovedCount)%;background:#00d28c;"></span>
        </div>
        <div class="dx-pipe-foot">
            <span>@pipeTotal design@(pipeTotal == 1 ? "" : "s") tracked</span>
            <span>@approvalRate% signed off</span>
        </div>
    </div>

    <!-- ACTION QUEUE + HEATMAP -->
    <div class="dx-grid2">
        <div class="dx-card">
            <div class="dx-head">
                <div>
                    <div class="dx-title">Needs your attention</div>
                    <div class="dx-sub">Most urgent first</div>
                </div>
            </div>
            @if (Model.Attention.Any())
            {
                <div class="dx-q">
                    @foreach (var a in Model.Attention)
                    {
                        var color = a.Kind == "changes" ? "#f59e0b" : a.Kind == "review" ? "#3b82f6" : "#94a3b8";
                        <a class="dx-qi" style="--c:@color;" asp-controller="Scrubber" asp-action="DesignDetail" asp-route-id="@a.DesignId">
                            <span class="rail"></span>
                            <span class="body">
                                <div class="nm">@a.DesignName</div>
                                <div class="why">
                                    @if (a.Kind == "changes")
                                    {
                                        <b>Changes requested</b><text> &middot; @a.ProjectNumber</text>
                                    }
                                    else if (a.Kind == "review")
                                    {
                                        <b>Awaiting sign-off</b><text> &middot; @a.ProjectNumber &middot; @a.AgeDays d</text>
                                    }
                                    else
                                    {
                                        <b>Stalled draft</b><text> &middot; @a.ProjectNumber &middot; idle @a.AgeDays d</text>
                                    }
                                </div>
                            </span>
                            <span class="go">@(a.Kind == "changes" ? "Fix" : a.Kind == "review" ? "Track" : "Resume") &rarr;</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="dx-empty">All clear &mdash; no designs are waiting on action.</div>
            }
        </div>

        <div class="dx-card">
            <div class="dx-head">
                <div>
                    <div class="dx-title">Engineering activity</div>
                    <div class="dx-sub" id="dx-heat-sub">Last 26 weeks</div>
                </div>
            </div>
            <div id="dx-heat"></div>
            <div class="dx-scale">Less
                <i style="background:#eef2f6"></i><i style="background:#bff0dc"></i><i style="background:#6fe0b4"></i><i style="background:#22c98d"></i><i style="background:#059669"></i>
                More
            </div>
        </div>
    </div>

    <!-- ENVELOPE + POLLUTANT MIX -->
    <div class="dx-grid2 rev">
        <div class="dx-card">
            <div class="dx-head">
                <div>
                    <div class="dx-title">Operating envelope</div>
                    <div class="dx-sub">Every design by gas flow and target removal &mdash; click a dot to open it</div>
                </div>
            </div>
            <div id="dx-env"></div>
            <div class="dx-legend" id="dx-env-legend"></div>
        </div>

        <div class="dx-card">
            <div class="dx-head">
                <div>
                    <div class="dx-title">Pollutant mix</div>
                    <div class="dx-sub">Each square is 1% of the pollutant streams you design for</div>
                </div>
            </div>
            <div id="dx-mix"></div>
        </div>
    </div>

    <!-- RECENT PROJECTS -->
    <div class="dx-card">
        <div class="dx-head">
            <div>
                <div class="dx-title">Pick up where you left off</div>
                <div class="dx-sub">Bar shows designs signed off in each project</div>
            </div>
            <a asp-controller="Project" asp-action="Index" class="view-all-link">View all &rarr;</a>
        </div>

        @if (Model.RecentProjects.Any())
        {
            <div class="dx-recent">
                @foreach (var p in Model.RecentProjects)
                {
                    int approved = p.Designs.Count(d => d.ReviewStatus == DesignReviewStatus.Approved);
                    int total = p.Designs.Count;
                    int pct = total == 0 ? 0 : approved * 100 / total;
                    <a class="dx-pc" asp-controller="Project" asp-action="Detail" asp-route-id="@p.ProjectId">
                        <div class="num">@p.ProjectNumber</div>
                        <div class="nm">@p.ProjectName</div>
                        <div class="cl">@p.ClientName</div>
                        <div class="dx-prog"><span style="width:@pct%"></span></div>
                        <div class="meta">
                            <span>@approved / @total signed off</span>
                            <span>@Ago(p.UpdatedAt)</span>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="dx-empty">
                No projects yet. Create your first wet scrubber design project.<br />
                <a asp-controller="Project" asp-action="Create" class="btn-new" style="display:inline-flex;margin-top:12px;">+ New Project</a>
            </div>
        }
    </div>
</div>

<div id="dx-tip"></div>
<script id="dx-data" type="application/json">@Html.Raw(Model.DataJson)</script>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
    <script>
        (function () {
            var data = JSON.parse(document.getElementById('dx-data').textContent);
            var tip = document.getElementById('dx-tip');
            var TYPE_COLORS = {
                PackedTower: '#3b82f6', VenturiScrubber: '#00d28c', SprayTower: '#f59e0b',
                WetCyclone: '#ef4444', ImpingementPlate: '#8b5cf6'
            };
            var MIX_COLORS = ['#00d28c', '#3b82f6', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4', '#ec4899', '#84cc16'];

            function showTip(html, e) {
                tip.innerHTML = html;
                tip.style.opacity = 1;
                var x = e.clientX + 14, y = e.clientY + 14;
                if (x + 270 > window.innerWidth) x = e.clientX - 270;
                tip.style.left = x + 'px';
                tip.style.top = y + 'px';
            }
            function hideTip() { tip.style.opacity = 0; }
            function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
            function pad(n) { return n < 10 ? '0' + n : '' + n; }
            function iso(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
            function prettyType(t) { return t.replace(/([a-z])([A-Z])/g, '$1 $2'); }

            // ── Activity heatmap ────────────────────────────────
            function drawHeat() {
                var host = document.getElementById('dx-heat');
                var colors = ['#eef2f6', '#bff0dc', '#6fe0b4', '#22c98d', '#059669'];
                var weeks = 26, cell = 13, gap = 3, step = cell + gap, left = 30, top = 18;
                var today = new Date(data.today + 'T00:00:00');
                var dow = (today.getDay() + 6) % 7;
                var gridStart = new Date(today);
                gridStart.setDate(today.getDate() - dow - (weeks - 1) * 7);

                var W = left + weeks * step, H = top + 7 * step;
                var out = '<svg class="dx-svg" viewBox="0 0 ' + W + ' ' + H + '">';
                var days = ['Mon', '', 'Wed', '', 'Fri', '', ''];
                for (var r = 0; r < 7; r++) {
                    if (days[r]) out += '<text x="0" y="' + (top + r * step + 10) + '" font-size="9" fill="#94a3b8">' + days[r] + '</text>';
                }

                var total = 0, lastMonth = -1;
                for (var w = 0; w < weeks; w++) {
                    for (var d = 0; d < 7; d++) {
                        var date = new Date(gridStart);
                        date.setDate(gridStart.getDate() + w * 7 + d);
                        if (date > today) continue;

                        if (d === 0 && date.getMonth() !== lastMonth) {
                            lastMonth = date.getMonth();
                            out += '<text x="' + (left + w * step) + '" y="10" font-size="9" fill="#94a3b8">' +
                                date.toLocaleString(undefined, { month: 'short' }) + '</text>';
                        }

                        var key = iso(date);
                        var n = data.activity[key] || 0;
                        total += n;
                        var lvl = n === 0 ? 0 : n === 1 ? 1 : n === 2 ? 2 : n <= 4 ? 3 : 4;
                        out += '<rect x="' + (left + w * step) + '" y="' + (top + d * step) + '" width="' + cell + '" height="' + cell +
                            '" rx="3" fill="' + colors[lvl] + '" data-k="' + key + '" data-n="' + n + '"></rect>';
                    }
                }
                out += '</svg>';
                host.innerHTML = out;
                document.getElementById('dx-heat-sub').textContent =
                    total + ' design event' + (total === 1 ? '' : 's') + ' in the last 26 weeks';

                host.addEventListener('mousemove', function (e) {
                    var t = e.target;
                    if (t.tagName !== 'rect') { hideTip(); return; }
                    var n = Number(t.getAttribute('data-n'));
                    var dt = new Date(t.getAttribute('data-k') + 'T00:00:00');
                    showTip('<b>' + n + ' event' + (n === 1 ? '' : 's') + '</b><br>' +
                        dt.toLocaleDateString(undefined, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }), e);
                });
                host.addEventListener('mouseleave', hideTip);
            }

            // ── Operating envelope ──────────────────────────────
            function drawEnvelope() {
                var host = document.getElementById('dx-env');
                var pts = (data.envelope || []).filter(function (p) { return p.flow > 0; }).map(function (p) {
                    var r = p.removal;
                    if (r > 0 && r <= 1) r = r * 100;
                    p.r = Math.max(0, Math.min(100, r));
                    return p;
                });
                if (!pts.length) {
                    host.innerHTML = '<div class="dx-empty">Create a design with gas data to see your operating envelope.</div>';
                    return;
                }

                var W = 640, H = 300, m = { l: 48, r: 16, t: 14, b: 40 };
                var flows = pts.map(function (p) { return p.flow; });
                var lo = Math.floor(Math.log10(Math.min.apply(null, flows)));
                var hi = Math.ceil(Math.log10(Math.max.apply(null, flows)));
                if (hi <= lo) hi = lo + 1;
                var minR = Math.min.apply(null, pts.map(function (p) { return p.r; }));
                var yMin = minR >= 60 ? 50 : 0, yMax = 100;

                function x(f) { return m.l + (Math.log10(f) - lo) / (hi - lo) * (W - m.l - m.r); }
                function y(r) { return m.t + (1 - (r - yMin) / (yMax - yMin)) * (H - m.t - m.b); }
                function fmt(v) { return v >= 1000 ? (v / 1000) + 'k' : String(v); }

                var out = '<svg class="dx-svg" viewBox="0 0 ' + W + ' ' + H + '">';
                out += '<rect x="' + m.l + '" y="' + y(100) + '" width="' + (W - m.l - m.r) + '" height="' + (y(95) - y(100)) +
                    '" fill="rgba(0,210,140,.10)"></rect>';
                out += '<text x="' + (W - m.r - 4) + '" y="' + (y(100) + 11) + '" font-size="9" text-anchor="end" fill="#059669">high-efficiency zone</text>';

                for (var v = yMin; v <= yMax; v += 10) {
                    out += '<line x1="' + m.l + '" x2="' + (W - m.r) + '" y1="' + y(v) + '" y2="' + y(v) + '" stroke="#e8edf3"></line>';
                    out += '<text x="' + (m.l - 8) + '" y="' + (y(v) + 3) + '" font-size="10" text-anchor="end" fill="#94a3b8">' + v + '</text>';
                }
                for (var e = lo; e <= hi; e++) {
                    var px = x(Math.pow(10, e));
                    out += '<line x1="' + px + '" x2="' + px + '" y1="' + m.t + '" y2="' + (H - m.b) + '" stroke="#e8edf3"></line>';
                    out += '<text x="' + px + '" y="' + (H - m.b + 15) + '" font-size="10" text-anchor="middle" fill="#94a3b8">' + fmt(Math.pow(10, e)) + '</text>';
                }
                out += '<text x="' + ((W + m.l) / 2) + '" y="' + (H - 6) + '" font-size="10" text-anchor="middle" fill="#64748b">Gas flow (m\u00B3/hr, log scale)</text>';
                out += '<text transform="translate(12 ' + (H / 2) + ') rotate(-90)" font-size="10" text-anchor="middle" fill="#64748b">Target removal (%)</text>';

                pts.forEach(function (p, i) {
                    var c = TYPE_COLORS[p.type] || '#64748b';
                    out += '<circle cx="' + x(p.flow).toFixed(1) + '" cy="' + y(p.r).toFixed(1) + '" r="6.5" fill="' + c +
                        '" fill-opacity=".72" stroke="#fff" stroke-width="1.5" style="cursor:pointer" data-i="' + i + '"></circle>';
                });
                out += '</svg>';
                host.innerHTML = out;

                host.addEventListener('mousemove', function (ev) {
                    var t = ev.target;
                    if (t.tagName !== 'circle') { hideTip(); return; }
                    var p = pts[Number(t.getAttribute('data-i'))];
                    showTip('<b>' + esc(p.name) + '</b><br>' + esc(p.project) + '<br>' +
                        Math.round(p.flow).toLocaleString() + ' m\u00B3/hr &middot; ' + p.r.toFixed(1) + '% removal<br>' +
                        esc(prettyType(p.type)) + ' &middot; ' + esc(prettyType(p.status)), ev);
                });
                host.addEventListener('mouseleave', hideTip);
                host.addEventListener('click', function (ev) {
                    var t = ev.target;
                    if (t.tagName !== 'circle') return;
                    var p = pts[Number(t.getAttribute('data-i'))];
                    window.location.href = '/Scrubber/DesignDetail/' + p.id;
                });

                var seen = {};
                pts.forEach(function (p) { seen[p.type] = true; });
                document.getElementById('dx-env-legend').innerHTML = Object.keys(seen).map(function (k) {
                    return '<span><i style="background:' + (TYPE_COLORS[k] || '#64748b') + '"></i>' + esc(prettyType(k)) + '</span>';
                }).join('');
            }

            // ── Pollutant waffle ────────────────────────────────
            function drawMix() {
                var host = document.getElementById('dx-mix');
                var mix = data.mix || [];
                var total = mix.reduce(function (s, p) { return s + p.count; }, 0);
                if (!total) {
                    host.innerHTML = '<div class="dx-empty">No pollutant data yet.</div>';
                    return;
                }

                var cells = mix.map(function (p) { return Math.floor(p.count * 100 / total); });
                var rem = mix.map(function (p, i) { return { i: i, f: (p.count * 100 / total) - cells[i] }; })
                    .sort(function (a, b) { return b.f - a.f; });
                var left = 100 - cells.reduce(function (s, c) { return s + c; }, 0);
                for (var k = 0; k < left; k++) cells[rem[k % rem.length].i]++;

                var squares = '';
                mix.forEach(function (p, i) {
                    for (var c = 0; c < cells[i]; c++) {
                        squares += '<i style="background:' + MIX_COLORS[i % MIX_COLORS.length] + '" title="' + esc(p.name) + '"></i>';
                    }
                });

                var list = mix.map(function (p, i) {
                    return '<div class="dx-mixrow"><i style="background:' + MIX_COLORS[i % MIX_COLORS.length] + '"></i><span>' +
                        esc(p.name) + ' <small style="color:#94a3b8">' + esc(p.code) + '</small></span><span>' +
                        Math.round(p.count * 100 / total) + '%</span></div>';
                }).join('');

                host.innerHTML = '<div class="dx-mix"><div class="dx-waffle">' + squares + '</div><div class="dx-mixlist">' + list + '</div></div>';
            }

            function init() { drawHeat(); drawEnvelope(); drawMix(); }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
            else init();
        })();
    </script>
}
