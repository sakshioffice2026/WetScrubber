@using WetScrubber.Database.Enums
@model WetScrubber.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";

    int pipeTotal = Model.DraftCount + Model.UnderReviewCount + Model.ChangesRequestedCount + Model.ApprovedCount;
    int needsAction = Model.ChangesRequestedCount + Model.UnderReviewCount;
    int weekDelta = Model.DesignsThisWeek - Model.DesignsLastWeek;

    string Pct(int n) => pipeTotal > 0 ? (n * 100.0 / pipeTotal).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "0";

    string Ago(DateTime dt)
    {
        var span = DateTime.UtcNow - dt.ToUniversalTime();
        if (span.TotalMinutes < 60) return Math.Max(1, (int)span.TotalMinutes) + " min ago";
        if (span.TotalHours < 24) return (int)span.TotalHours + " h ago";
        if (span.TotalDays < 30) return (int)span.TotalDays + " d ago";
        return dt.ToString("dd MMM yyyy");
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/project.css" />
}

@section TopbarActions {
    <a asp-controller="Project" asp-action="Create" class="btn-new">
        <svg viewBox="0 0 16 16" width="13" height="13">
            <path d="M8 1v14M1 8h14" stroke="#0b1120" stroke-width="2" fill="none" />
        </svg>
        New Project
    </a>
}

<style>
    .dx { --ink:#0f172a; --muted:#64748b; --line:rgba(100,116,139,.22); --accent:#00d28c; }
    .dx * { box-sizing: border-box; }
    .dx-card { background:#fff; border:1px solid var(--line); border-radius:16px; padding:20px 22px; }
    .dx-title { font-size:.95rem; font-weight:700; color:var(--ink); }
    .dx-sub { font-size:.78rem; color:var(--muted); margin-top:2px; }
    .dx-head { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:14px; gap:10px; }
    .dx-grid2 { display:grid; grid-template-columns:1.05fr 1fr; gap:16px; margin-bottom:16px; }
    .dx-grid2.single { grid-template-columns:1fr; }
    .dx-empty { text-align:center; color:var(--muted); font-size:.85rem; padding:34px 10px; }

    /* hero */
    .dx-hero {
        display:flex; justify-content:space-between; align-items:center; gap:18px; flex-wrap:wrap;
        padding:24px 26px; border-radius:18px; margin-bottom:16px; color:#e2f8ef;
        background: radial-gradient(1200px 300px at 85% -40%, rgba(0,210,140,.35), transparent 60%), linear-gradient(120deg,#0b1730,#0f2a3d);
    }
    .dx-hero h3 { margin:0 0 6px; font-size:1.45rem; color:#fff; }
    .dx-hero p { margin:0; opacity:.82; font-size:.92rem; }
    .dx-hero b { color:#6ff2c4; }
    .dx-actions { display:flex; gap:10px; flex-wrap:wrap; }
    .dx-btn {
        display:inline-flex; align-items:center; gap:8px; padding:10px 16px; border-radius:11px; font-size:.86rem; font-weight:600;
        text-decoration:none; border:1px solid rgba(255,255,255,.25); color:#fff; background:rgba(255,255,255,.08); transition:all .15s;
    }
    .dx-btn:hover { background:rgba(255,255,255,.18); transform:translateY(-1px); }
    .dx-btn.primary { background:var(--accent); border-color:var(--accent); color:#04281c; }
    .dx-btn.primary:hover { background:#27e0a4; }

    /* stat tiles */
    .dx-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:16px; }
    .dx-stat { padding:16px 18px; }
    .dx-stat .lbl { font-size:.7rem; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
    .dx-stat .val { font-size:1.9rem; font-weight:800; color:var(--ink); line-height:1.15; margin-top:4px; }
    .dx-chip { display:inline-block; margin-top:6px; font-size:.72rem; font-weight:600; padding:2px 8px; border-radius:999px; background:#eef2f6; color:var(--muted); }
    .dx-chip.up { background:#dcfce9; color:#047857; }
    .dx-chip.down { background:#fee2e2; color:#b91c1c; }

    /* pipeline */
    .dx-pipe { display:grid; grid-template-columns:repeat(4,1fr); gap:0; margin-bottom:14px; }
    .dx-stage { position:relative; padding:12px 16px 12px 22px; border-top:3px solid var(--c); }
    .dx-stage:not(:last-child)::after {
        content:""; position:absolute; right:-9px; top:-3px; width:18px; height:18px; z-index:2;
        background:#fff; border-top:3px solid var(--c); border-right:3px solid var(--c); transform:rotate(45deg) scale(.55); transform-origin:center;
    }
    .dx-stage .n { font-size:1.6rem; font-weight:800; color:var(--ink); }
    .dx-stage .t { font-size:.78rem; color:var(--muted); }
    .dx-bar { display:flex; height:10px; border-radius:999px; overflow:hidden; background:#eef2f6; }
    .dx-bar span { display:block; height:100%; transition:width .4s; }
    .dx-pipe-foot { display:flex; justify-content:space-between; font-size:.78rem; color:var(--muted); margin-top:8px; }

    /* attention queue */
    .dx-q { display:flex; flex-direction:column; gap:10px; }
    .dx-qi {
        display:grid; grid-template-columns:4px 1fr auto; gap:12px; align-items:center; padding:11px 14px 11px 0;
        border:1px solid var(--line); border-radius:12px; text-decoration:none; color:inherit; background:#fff; overflow:hidden; transition:all .15s;
    }
    .dx-qi:hover { border-color:var(--accent); box-shadow:0 6px 16px rgba(15,23,42,.07); transform:translateY(-1px); }
    .dx-qi .rail { align-self:stretch; background:var(--c); }
    .dx-qi .nm { font-weight:600; font-size:.9rem; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .dx-qi .why { font-size:.78rem; color:var(--muted); margin-top:2px; }
    .dx-qi .why b { color:var(--c); font-weight:700; }
    .dx-qi .go { font-size:.78rem; font-weight:700; color:var(--c); white-space:nowrap; }
    .dx-qi .body { min-width:0; }


    /* recent project cards */
    .dx-recent { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:14px; }
    .dx-pc { display:block; padding:16px; border:1px solid var(--line); border-radius:14px; text-decoration:none; color:inherit; background:#fff; transition:all .15s; }
    .dx-pc:hover { border-color:var(--accent); box-shadow:0 8px 20px rgba(15,23,42,.08); transform:translateY(-2px); }
    .dx-pc .num { font-size:.72rem; color:var(--muted); }
    .dx-pc .nm { font-weight:700; color:var(--ink); margin:3px 0 2px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:2.6em; }
    .dx-pc .cl { font-size:.8rem; color:var(--muted); margin-bottom:12px; }
    .dx-prog { height:6px; border-radius:999px; background:#eef2f6; overflow:hidden; }
    .dx-prog span { display:block; height:100%; background:var(--accent); border-radius:999px; }
    .dx-pc .meta { display:flex; justify-content:space-between; font-size:.74rem; color:var(--muted); margin-top:7px; }

    @@media (max-width: 1100px) {
        .dx-grid2 { grid-template-columns:1fr; }
        .dx-stats { grid-template-columns:repeat(2,1fr); }
    }
    @@media (max-width: 640px) {
        .dx-pipe { grid-template-columns:repeat(2,1fr); }
        .dx-stage::after { display:none; }
    }
</style>

<div class="dx">

    <!-- HERO -->
    <div class="dx-hero">
        <div>
            <h3>@greeting, @Model.UserFullName.Split(' ').First()</h3>
            <p>
                @if (needsAction > 0)
                {
                    <text><b>@needsAction</b> design@(needsAction == 1 ? "" : "s") need@(needsAction == 1 ? "s" : "") your attention</text>
                    if (Model.ChangesRequestedCount > 0)
                    {
                        <text> &middot; <b>@Model.ChangesRequestedCount</b> with changes requested</text>
                    }
                }
                else
                {
                    <text>You're all caught up &mdash; nothing is waiting on you.</text>
                }
                &middot; Last login @Model.LastLoginAt.ToLocalTime().ToString("dd MMM, hh:mm tt")
            </p>
        </div>
        <div class="dx-actions">
            <a class="dx-btn primary" asp-controller="Scrubber" asp-action="New">+ New Design</a>
            <a class="dx-btn" asp-controller="Flowsheet" asp-action="Index">Flowsheets</a>
            <a class="dx-btn" asp-controller="Report" asp-action="Index">Reports</a>
        </div>
    </div>

    <!-- STAT TILES -->
    <div class="dx-stats">
        <div class="dx-card dx-stat">
            <div class="lbl">Projects</div>
            <div class="val">@Model.TotalProjects</div>
            <span class="dx-chip">@Model.ActiveProjects in progress</span>
        </div>
        <div class="dx-card dx-stat">
            <div class="lbl">Designs</div>
            <div class="val">@Model.TotalDesigns</div>
            <span class="dx-chip @(weekDelta > 0 ? "up" : weekDelta < 0 ? "down" : "")">
                @(weekDelta > 0 ? "▲ " + weekDelta : weekDelta < 0 ? "▼ " + Math.Abs(weekDelta) : "—") vs last week
            </span>
        </div>
        <div class="dx-card dx-stat">
            <div class="lbl">Flowsheets</div>
            <div class="val">@Model.FlowsheetCount</div>
            <span class="dx-chip">Process simulations</span>
        </div>
    </div>

    <!-- REVIEW PIPELINE -->
    <div class="dx-card" style="margin-bottom:16px;">
        <div class="dx-head">
            <div>
                <div class="dx-title">Design review pipeline</div>
                <div class="dx-sub">Where every design sits on the road to PE sign-off</div>
            </div>
        </div>
        <div class="dx-pipe">
            <div class="dx-stage" style="--c:#94a3b8;"><div class="n">@Model.DraftCount</div><div class="t">Draft</div></div>
            <div class="dx-stage" style="--c:#3b82f6;"><div class="n">@Model.UnderReviewCount</div><div class="t">Under review</div></div>
            <div class="dx-stage" style="--c:#f59e0b;"><div class="n">@Model.ChangesRequestedCount</div><div class="t">Changes requested</div></div>
            <div class="dx-stage" style="--c:#00d28c;"><div class="n">@Model.ApprovedCount</div><div class="t">Approved &amp; locked</div></div>
        </div>
        <div class="dx-bar">
            <span style="width:@Pct(Model.DraftCount)%;background:#94a3b8;"></span>
            <span style="width:@Pct(Model.UnderReviewCount)%;background:#3b82f6;"></span>
            <span style="width:@Pct(Model.ChangesRequestedCount)%;background:#f59e0b;"></span>
            <span style="width:@Pct(Model.ApprovedCount)%;background:#00d28c;"></span>
        </div>
        <div class="dx-pipe-foot">
            <span>@pipeTotal design@(pipeTotal == 1 ? "" : "s") tracked</span>
        </div>
    </div>

    <!-- ACTION QUEUE -->
    <div class="dx-grid2 single">
        <div class="dx-card">
            <div class="dx-head">
                <div>
                    <div class="dx-title">Needs your attention</div>
                    <div class="dx-sub">Most urgent first</div>
                </div>
            </div>
            @if (Model.Attention.Any())
            {
                <div class="dx-q">
                    @foreach (var a in Model.Attention)
                    {
                        var color = a.Kind == "changes" ? "#f59e0b" : a.Kind == "review" ? "#3b82f6" : "#94a3b8";
                        <a class="dx-qi" style="--c:@color;" asp-controller="Scrubber" asp-action="DesignDetail" asp-route-id="@a.DesignId">
                            <span class="rail"></span>
                            <span class="body">
                                <div class="nm">@a.DesignName</div>
                                <div class="why">
                                    @if (a.Kind == "changes")
                                    {
                                        <b>Changes requested</b><text> &middot; @a.ProjectNumber</text>
                                    }
                                    else if (a.Kind == "review")
                                    {
                                        <b>Awaiting sign-off</b><text> &middot; @a.ProjectNumber &middot; @a.AgeDays d</text>
                                    }
                                    else
                                    {
                                        <b>Stalled draft</b><text> &middot; @a.ProjectNumber &middot; idle @a.AgeDays d</text>
                                    }
                                </div>
                            </span>
                            <span class="go">@(a.Kind == "changes" ? "Fix" : a.Kind == "review" ? "Track" : "Resume") &rarr;</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="dx-empty">All clear &mdash; no designs are waiting on action.</div>
            }
        </div>
    </div>

    <!-- RECENT PROJECTS -->
    <div class="dx-card">
        <div class="dx-head">
            <div>
                <div class="dx-title">Pick up where you left off</div>
                <div class="dx-sub">Bar shows designs signed off in each project</div>
            </div>
            <a asp-controller="Project" asp-action="Index" class="view-all-link">View all &rarr;</a>
        </div>

        @if (Model.RecentProjects.Any())
        {
            <div class="dx-recent">
                @foreach (var p in Model.RecentProjects)
                {
                    int approved = p.Designs.Count(d => d.ReviewStatus == DesignReviewStatus.Approved);
                    int total = p.Designs.Count;
                    int pct = total == 0 ? 0 : approved * 100 / total;
                    <a class="dx-pc" asp-controller="Project" asp-action="Detail" asp-route-id="@p.ProjectId">
                        <div class="num">@p.ProjectNumber</div>
                        <div class="nm">@p.ProjectName</div>
                        <div class="cl">@p.ClientName</div>
                        <div class="dx-prog"><span style="width:@pct%"></span></div>
                        <div class="meta">
                            <span>@approved / @total signed off</span>
                            <span>@Ago(p.UpdatedAt)</span>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="dx-empty">
                No projects yet. Create your first wet scrubber design project.<br />
                <a asp-controller="Project" asp-action="Create" class="btn-new" style="display:inline-flex;margin-top:12px;">+ New Project</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
}
