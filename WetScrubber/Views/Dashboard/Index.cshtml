@using WetScrubber.Database.Enums
@model WetScrubber.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";

    var typeColors = new[] { "#00d28c", "#3b82f6", "#f59e0b", "#ef4444", "#8b5cf6", "#06b6d4" };
    int totalTypeCount = Model.ScrubberTypes.Sum(t => t.Count);
}

@section Styles {
    <link rel="stylesheet" href="~/css/project.css" />
}

@section TopbarActions {
    <a asp-controller="Project" asp-action="Create" class="btn-new">
        <svg viewBox="0 0 16 16" width="13" height="13">
            <path d="M8 1v14M1 8h14" stroke="#0b1120" stroke-width="2" fill="none" />
        </svg>
        New Project
    </a>
}

<!-- Welcome Banner -->
<div class="welcome-banner">
    <div class="welcome-text">
        <h3>Welcome back, @Model.UserFullName.Split(' ').First() 👋</h3>
        <p>
            @Model.UserRole
            @if (!string.IsNullOrEmpty(Model.UserCompany))
            {
                <text>· @Model.UserCompany</text>
            }
            · Last login: @Model.LastLoginAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
        </p>
    </div>
    <div class="welcome-role-badge">@Model.UserRole</div>
</div>

<!-- KPI Cards -->
<div class="kpi-grid">

    <div class="kpi-card green">
        <div class="kpi-icon-box">
            <svg viewBox="0 0 16 16" fill="currentColor">
                <path d="M2 3a1 1 0 011-1h10a1 1 0 011 1v10a1 1 0 01-1 1H3a1 1 0 01-1-1V3zm2 2v2h8V5H4zm0 4v2h5V9H4z" />
            </svg>
        </div>
        <div class="kpi-label">Total Projects</div>
        <div class="kpi-value">@Model.TotalProjects</div>
        <div class="kpi-hint">All your projects</div>
    </div>

    <div class="kpi-card amber">
        <div class="kpi-icon-box">
            <svg viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 1a7 7 0 100 14A7 7 0 008 1zm1 4H7v4l3.5 2.1.7-1.2L8 8.5V5z" />
            </svg>
        </div>
        <div class="kpi-label">Total Designs</div>
        <div class="kpi-value">@Model.TotalDesigns</div>
        <div class="kpi-hint">Across all projects</div>
    </div>

    <div class="kpi-card blue">
        <div class="kpi-icon-box">
            <svg viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 1a7 7 0 100 14A7 7 0 008 1zm0 2a5 5 0 110 10A5 5 0 018 3zm.5 2.5h-1v4l3 1.8.5-.9-2.5-1.5V5.5z" />
            </svg>
        </div>
        <div class="kpi-label">Last Login</div>
        <div class="kpi-value sm">@Model.LastLoginAt.ToLocalTime().ToString("dd MMM yyyy")</div>
        <div class="kpi-hint">@Model.LastLoginAt.ToLocalTime().ToString("hh:mm tt")</div>
    </div>

</div>

<!-- Charts Row -->
<div class="two-col">

    <!-- Bar Chart -->
    <div class="dash-card">
        <div class="dash-card-header">
            <div>
                <div class="dash-card-title">Designs per month</div>
                <div class="dash-card-sub">Last 6 months</div>
            </div>
        </div>
        <div class="bar-chart"
             id="barChart"
             data-months="@Model.ChartMonths"
             data-values="@Model.ChartValues">
        </div>
    </div>

    <!-- Scrubber type breakdown -->
    <div class="dash-card">
        <div class="dash-card-header">
            <div>
                <div class="dash-card-title">Scrubber types</div>
                <div class="dash-card-sub">By design count</div>
            </div>
        </div>

        @if (Model.ScrubberTypes.Any())
        {
            <div class="type-list">
                @for (int i = 0; i < Model.ScrubberTypes.Count; i++)
                {
                    var t = Model.ScrubberTypes[i];
                    var pct = totalTypeCount > 0
                    ? (int)Math.Round((double)t.Count / totalTypeCount * 100)
                    : 0;
                    var col = typeColors[i % typeColors.Length];

                    <div class="type-row">
                        <div class="type-dot" style="background:@col"></div>
                        <span class="type-name">@t.TypeName.Replace("Tower", "").Replace("Scrubber", "").Trim()</span>
                        <div class="type-bar-bg">
                            <div class="type-bar-fill" style="width:@pct%;background:@col"></div>
                        </div>
                        <span class="type-pct">@pct%</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="font-size:12px;color:#bbb;text-align:center;padding:24px 0;">
                No designs yet
            </p>
        }
    </div>

</div>

<!-- Recent Projects Table -->
<div class="dash-card">
    <div class="dash-card-header">
        <div>
            <div class="dash-card-title">Recent projects</div>
            <div class="dash-card-sub">Your last 5 updated projects</div>
        </div>
        <a asp-controller="Project" asp-action="Index" class="view-all-link">View all →</a>
    </div>

    @if (Model.RecentProjects.Any())
    {
        <div class="projects-table-wrap">
            <table class="projects-table">
                <thead>
                    <tr>
                        <th>Project #</th>
                        <th>Name</th>
                        <th>Client</th>
                        <th style="text-align:center;">Designs</th>
                        <th>Status</th>
                        <th>Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.RecentProjects)
                    {
                        string badgeClass, statusLabel;
                        if (p.Status == ProjectStatus.Completed) { badgeClass = "badge-completed"; statusLabel = "Completed"; }
                        else if (p.Status == ProjectStatus.InProgress) { badgeClass = "badge-inprogress"; statusLabel = "In Progress"; }
                        else if (p.Status == ProjectStatus.Archived) { badgeClass = "badge-draft"; statusLabel = "Archived"; }
                        else { badgeClass = "badge-draft"; statusLabel = "Draft"; }

                        <tr data-href="/Project/Detail/@p.ProjectId" style="cursor:pointer;">
                            <td><span class="proj-number">@p.ProjectNumber</span></td>
                            <td><span class="proj-name">@p.ProjectName</span></td>
                            <td><span class="proj-client">@p.ClientName</span></td>
                            <td class="proj-count" style="text-align:center;">@p.Designs.Count</td>
                            <td><span class="status-badge @badgeClass">@statusLabel</span></td>
                            <td class="proj-date">@p.UpdatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No projects yet. Create your first wet scrubber design project.</p>
            <a asp-controller="Project" asp-action="Create" class="btn-new" style="display:inline-flex;">
                + New Project
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
}
