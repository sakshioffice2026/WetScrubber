@model WetScrubber.Models.ReportReviewViewModel
@{
    ViewData["Title"] = "Report Review";
    ViewData["ActivePage"] = "ExportReports";

    var statusBadgeClass = Model.Status switch
    {
        WetScrubber.Database.Enums.ReportStatus.Approved => "badge-completed",
        WetScrubber.Database.Enums.ReportStatus.NarrativeDrafted => "badge-inprogress",
        WetScrubber.Database.Enums.ReportStatus.Rejected => "badge-inprogress",
        _ => "badge-draft"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/project.css" />
    <link rel="stylesheet" href="~/css/scrubber.css" />
    <link rel="stylesheet" href="~/css/results.css" />
    <style>
        .report-two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        .report-narrative-body {
            padding: 18px 22px;
            white-space: pre-wrap;
            font-size: 13px;
            line-height: 1.6;
            color: #333;
            max-height: 420px;
            overflow-y: auto;
        }

        .report-ai-actions {
            padding: 0 22px 18px;
        }

        .report-ai-empty {
            padding: 0 22px 18px;
            font-size: 12.5px;
            color: #999;
        }

        .report-warning {
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: #92400e;
            border-radius: 8px;
            padding: 12px 16px;
            font-size: 12.5px;
            margin-bottom: 16px;
        }
    </style>
}

@section TopbarActions {
    <a asp-controller="Scrubber" asp-action="DesignDetail"
       asp-route-id="@Model.DesignId"
       class="btn-cancel"
       style="height:34px;padding:0 14px;font-size:12.5px;display:flex;align-items:center;">
        ← Back to Design
    </a>
}

<div class="results-header-card">
    <div class="results-header-left">
        <div class="results-badge-type">Design Report</div>
        <div class="results-title">@Model.DesignName</div>
        <div class="results-subtitle">
            Status:
            <span class="status-badge @statusBadgeClass">@Model.Status</span>
            &nbsp;·&nbsp; Narrative source: @Model.NarrativeSource
        </div>
    </div>
</div>

@if (Model.AiDraftFailed)
{
    <div class="report-warning">
        AI drafting failed: @Model.AiDraftError
        <br />The template-only report below is unaffected — you can still use it as-is.
    </div>
}

<div class="report-two-col">

    <div class="results-data-card">
        <div class="results-data-header">
            <div class="results-data-title">Engine template</div>
            <div class="results-data-sub">Deterministic — source of record</div>
        </div>
        <div class="report-narrative-body">@Model.TemplateNarrative</div>
    </div>

    <div class="results-data-card">
        <div class="results-data-header">
            <div class="results-data-title">AI-drafted narrative</div>
            <div class="results-data-sub">Advisory — rewording only, never changes a number</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.AiNarrative))
        {
            <div class="report-narrative-body">@Model.AiNarrative</div>
        }
        else
        {
            <div class="report-ai-empty">No AI draft yet.</div>
        }

        <div class="report-ai-actions">
            <form asp-controller="Report" asp-action="DraftWithAi" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reportId" value="@Model.ReportId" />
                <button type="submit" class="btn-run-calc" style="height:36px;padding:0 16px;">
                    @(string.IsNullOrWhiteSpace(Model.AiNarrative) ? "Draft with AI" : "Re-draft with AI")
                </button>
            </form>
        </div>
    </div>

</div>

<div style="font-size:12.5px;color:#999;padding:4px 2px;">
    Done reviewing? Head back to the design's <strong>Results</strong> page to generate/update
    the report, redesign per this narrative, or compare with the previous revision.
</div>
