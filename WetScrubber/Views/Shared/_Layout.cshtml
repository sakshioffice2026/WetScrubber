@{
    var userName = Context.Session.GetString("UserName") ?? "User";
    var userRole = Context.Session.GetString("UserRole") ?? "Engineer";
    var initials = string.Concat(userName.Split(' ').Take(2)
                        .Where(w => w.Length > 0)
                        .Select(w => w[0]))
                        .ToUpper();

    // Each view sets ViewData["ActivePage"] to highlight correct nav item
    var activePage = ViewData["ActivePage"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — WetScrubber Pro</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Base app styles -->
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/app-theme.css" />

    <!-- Page-specific styles injected by each view -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="shell">

        <!-- ═══════════════════════════════════════════════
             SIDEBAR  — rendered once here for all pages
        ════════════════════════════════════════════════ -->
        <nav class="sb" id="sidebar">

            <div class="sb-toggle" id="sbToggle">
                <svg viewBox="0 0 10 10" fill="none">
                    <path d="M3 2l4 3-4 3" stroke="#888" stroke-width="1.5"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>

            <div class="sb-logo">
                <div class="sb-logo-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#0b1120"
                         stroke-width="2.5" stroke-linecap="round">
                        <path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z" />
                        <circle cx="12" cy="9" r="2.5" fill="#0b1120" stroke="none" />
                    </svg>
                </div>
                <div class="sb-logo-text">Wet<span>Scrubber</span> Pro</div>
            </div>

            <div class="sb-nav">

                <div class="sb-section">Main</div>

                <a asp-controller="Dashboard" asp-action="Index"
                   class="sb-item @(activePage == "Dashboard" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="7" height="7" x="3" y="3" rx="1" /><rect width="7" height="7" x="14" y="3" rx="1" /><rect width="7" height="7" x="14" y="14" rx="1" /><rect width="7" height="7" x="3" y="14" rx="1" />
                    </svg>
                    <span class="sb-item-label">Dashboard</span>
                </a>

                <div class="sb-section">Projects &amp; Designs</div>

                <a asp-controller="Project" asp-action="Index"
                   class="sb-item @(activePage == "Projects" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
                    </svg>
                    <span class="sb-item-label">Projects</span>
                </a>

                <a asp-controller="Project" asp-action="Index"
                   class="sb-item @(activePage == "NewDesign" ? "active" : "")"
                   title="Pick a project then click Add Design">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" /><path d="M8 12h8" /><path d="M12 8v8" />
                    </svg>
                    <span class="sb-item-label">New Design</span>
                </a>

                <a asp-controller="Flowsheet" asp-action="Index"
                   class="sb-item @(activePage == "Flowsheets" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="8" height="8" x="3" y="3" rx="2" /><path d="M7 11v4a2 2 0 0 0 2 2h4" /><rect width="8" height="8" x="13" y="13" rx="2" />
                    </svg>
                    <span class="sb-item-label">Flowsheets</span>
                </a>

                <a asp-controller="Project" asp-action="Index"
                   class="sb-item @(activePage == "Reports" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M10 9H8" /><path d="M16 13H8" /><path d="M16 17H8" />
                    </svg>
                    <span class="sb-item-label">Export Reports</span>
                </a>

                <div class="sb-section">Chemical &amp; Process Data</div>

                <a asp-controller="Chemistry" asp-action="Index"
                   class="sb-item @(activePage == "Chemistry" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2" /><path d="M8.5 2h7" /><path d="M7 16h10" />
                    </svg>
                    <span class="sb-item-label">Chemistry</span>
                </a>

                <a asp-controller="Chemistry" asp-action="Calculation"
                   class="sb-item @(activePage == "ChemistryCalculation" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="16" height="20" x="4" y="2" rx="2" /><line x1="8" x2="16" y1="6" y2="6" /><line x1="16" x2="16" y1="14" y2="18" /><path d="M16 10h.01" /><path d="M12 10h.01" /><path d="M8 10h.01" /><path d="M12 14h.01" /><path d="M8 14h.01" /><path d="M12 18h.01" /><path d="M8 18h.01" />
                    </svg>
                    <span class="sb-item-label">Chem Calculation</span>
                </a>

                <a asp-controller="Pollutant" asp-action="Index"
                   class="sb-item @(activePage == "Pollutants" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" /><path d="M12 9v4" /><path d="M12 17h.01" />
                    </svg>
                    <span class="sb-item-label">Pollutants</span>
                </a>

                <a asp-controller="ScrubbingLiquid" asp-action="Index"
                   class="sb-item @(activePage == "ScrubbingLiquids" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z" />
                    </svg>
                    <span class="sb-item-label">Scrubbing Liquids</span>
                </a>

            </div>

            <div class="sb-bottom">
                <div class="sb-user">
                    <div class="sb-avatar">@initials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@userName</div>
                        <div class="sb-user-role">@userRole</div>
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sb-logout" id="logoutBtn">
                        <svg viewBox="0 0 16 16" fill="currentColor">
                            <path d="M6 2H3a1 1 0 00-1 1v10a1 1 0 001 1h3v-1.5H3.5v-9H6V2zm4.854 3.146l2.5 2.5a.5.5 0 010 .708l-2.5 2.5-1.061-1.061L11.44 8.5H6V7h5.44L9.793 5.707l1.061-1.061z" />
                        </svg>
                        <span class="sb-logout-label">Sign out</span>
                    </button>
                </form>
            </div>

        </nav>

        <!-- ═══════════════════════════════════════════════
             MAIN CONTENT AREA
        ════════════════════════════════════════════════ -->
        <div class="main" id="mainContent">

            <!-- Topbar -->
            <div class="topbar">
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-right">

                    @* Each view can inject topbar buttons here *@
                    @await RenderSectionAsync("TopbarActions", required: false)

                    <div class="topbar-icon-btn" title="Notifications">
                        <svg viewBox="0 0 16 16" fill="currentColor">
                            <path d="M8 1a5 5 0 00-5 5v3L1.5 11.5h13L13 9V6a5 5 0 00-5-5zm0 14a2 2 0 002-2H6a2 2 0 002 2z" />
                        </svg>
                    </div>

                </div>
            </div>

            <!-- Page body — each view renders here -->
            <div class="page-body">

                @* Flash messages — available on every page *@
                @if (TempData["Success"] != null)
                {
                    <div class="flash-toast flash-success">✓ @TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="flash-toast flash-error">⚠ @TempData["Error"]</div>
                }

                @RenderBody()

            </div>
        </div>

    </div>

    <!-- jQuery + shared JS -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/dashboard.js"></script>

    @* Page-specific scripts injected by each view *@
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
