@model WetScrubber.Models.ReactionFormViewModel
@{
    ViewData["Title"] = "Add Reaction";
    ViewData["ActivePage"] = "Chemistry";
}

@section Styles {
    <link rel="stylesheet" href="~/css/project.css" />
    <link rel="stylesheet" href="~/css/scrubber.css" />
    <link rel="stylesheet" href="~/css/chemistry.css" />
    <link rel="stylesheet" href="~/css/chemistry-crud.css" />
}

<div class="breadcrumb">
    <a asp-action="Index">Chemical Reactions</a>
    <svg viewBox="0 0 16 16" width="12" height="12"><path d="M6 4l4 4-4 4" stroke="#ccc" stroke-width="1.5" fill="none" stroke-linecap="round" /></svg>
    <span>Add</span>
</div>

<div class="form-page-wrap">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <partial name="_ReactionForm" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn-save">
                <svg viewBox="0 0 16 16"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z" /></svg>
                Save Reaction
            </button>
            <a asp-action="Index" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>
