@model WetScrubber.Models.ChemistryCalculationFormViewModel
@{
    ViewData["Title"] = "Chemistry Calculation";
    ViewData["ActivePage"] = "ChemistryCalculation";
}

@section Styles {
    <link rel="stylesheet" href="~/css/project.css" />
    <link rel="stylesheet" href="~/css/scrubber.css" />
    <link rel="stylesheet" href="~/css/chemistry.css" />
    <link rel="stylesheet" href="~/css/chemistry-crud.css" />
}

<!-- Breadcrumb -->
<div class="breadcrumb">
    <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
    <svg viewBox="0 0 16 16" width="12" height="12"><path d="M6 4l4 4-4 4" stroke="#ccc" stroke-width="1.5" fill="none" stroke-linecap="round" /></svg>
    <a asp-action="Index">Chemical Reactions</a>
    <svg viewBox="0 0 16 16" width="12" height="12"><path d="M6 4l4 4-4 4" stroke="#ccc" stroke-width="1.5" fill="none" stroke-linecap="round" /></svg>
    <span>Calculation</span>
</div>

<div class="chem-intro-card">
    <div class="chem-intro-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#00d28c" stroke-width="2" stroke-linecap="round">
            <path d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18" />
        </svg>
    </div>
    <div>
        <div class="chem-intro-title">Chemistry Calculation</div>
        <div class="chem-intro-desc">
            Enter gas and liquid stream conditions for a pollutant / scrubbing
            liquid pair. This runs the full mass-transfer, equilibrium and
            material-balance engine and produces a report ready for review.
        </div>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="flash-toast error">
        <div asp-validation-summary="ModelOnly"></div>
    </div>
}

<div class="form-page-wrap">
    <form asp-action="Calculation" method="post">
        @Html.AntiForgeryToken()

        <div class="form-card">
            <div class="form-card-header">
                <div class="form-card-icon">
                    <svg viewBox="0 0 16 16"><path d="M2 3a1 1 0 011-1h10a1 1 0 011 1v10a1 1 0 01-1 1H3a1 1 0 01-1-1V3z" /></svg>
                </div>
                <div>
                    <div class="form-card-title">Reaction Pair</div>
                    <div class="form-card-sub">Which pollutant and liquid this calculation is for</div>
                </div>
            </div>
            <div class="form-card-body">
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="PollutantId">Pollutant <span class="req">*</span></label>
                        <select asp-for="PollutantId">
                            <option value="">— select —</option>
                            @foreach (var p in Model.Pollutants)
                            {
                                <option value="@p.Id">@p.DisplayName (@Html.Raw(p.Formula))</option>
                            }
                        </select>
                        <span class="field-error">@Html.ValidationMessageFor(m => m.PollutantId)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ScrubbingLiquidId">Scrubbing Liquid <span class="req">*</span></label>
                        <select asp-for="ScrubbingLiquidId">
                            <option value="">— select —</option>
                            @foreach (var l in Model.Liquids)
                            {
                                <option value="@l.Id">@l.DisplayName (@Html.Raw(l.Formula))</option>
                            }
                        </select>
                        <span class="field-error">@Html.ValidationMessageFor(m => m.ScrubbingLiquidId)</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-header">
                <div class="form-card-icon">
                    <svg viewBox="0 0 16 16"><path d="M2 2h12v2H2zm0 4h8v2H2zm0 4h10v2H2z" /></svg>
                </div>
                <div>
                    <div class="form-card-title">Gas Stream</div>
                    <div class="form-card-sub">Inlet conditions</div>
                </div>
            </div>
            <div class="form-card-body">
                <div class="fg3">
                    <div class="form-group">
                        <label asp-for="InletConcentrationPpmv">Inlet Concentration <span class="unit">(ppmv)</span></label>
                        <input asp-for="InletConcentrationPpmv" type="number" step="any" />
                        <span class="field-error">@Html.ValidationMessageFor(m => m.InletConcentrationPpmv)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="InletGasFlowKmolPerHr">Gas Flow <span class="unit">(kmol/hr)</span></label>
                        <input asp-for="InletGasFlowKmolPerHr" type="number" step="any" />
                        <span class="field-error">@Html.ValidationMessageFor(m => m.InletGasFlowKmolPerHr)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="InletGasDensityKgM3">Gas Density <span class="unit">(kg/m³)</span></label>
                        <input asp-for="InletGasDensityKgM3" type="number" step="any" />
                    </div>
                    <div class="form-group">
                        <label asp-for="InletGasViscosityPas">Gas Viscosity <span class="unit">(Pa·s)</span></label>
                        <input asp-for="InletGasViscosityPas" type="number" step="any" />
                    </div>
                    <div class="form-group">
                        <label asp-for="InletGasDiffusivityM2S">Gas Diffusivity <span class="unit">(m²/s)</span></label>
                        <input asp-for="InletGasDiffusivityM2S" type="number" step="any" />
                    </div>
                    <div class="form-group"></div>
                </div>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-header">
                <div class="form-card-icon">
                    <svg viewBox="0 0 16 16"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm.75 10.5h-1.5v-5h1.5v5zm0-6.5h-1.5V3.5h1.5V5z" /></svg>
                </div>
                <div>
                    <div class="form-card-title">Liquid Stream</div>
                    <div class="form-card-sub">Inlet conditions and reagent</div>
                </div>
            </div>
            <div class="form-card-body">
                <div class="fg3">
                    <div class="form-group">
                        <label asp-for="InletLiquidFlowKmolPerHr">Liquid Flow <span class="unit">(kmol/hr)</span></label>
                        <input asp-for="InletLiquidFlowKmolPerHr" type="number" step="any" />
                        <span class="field-error">@Html.ValidationMessageFor(m => m.InletLiquidFlowKmolPerHr)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="InletLiquidMoleFraction">Inlet Liquid Mole Fraction</label>
                        <input asp-for="InletLiquidMoleFraction" type="number" step="any" />
                    </div>
                    <div class="form-group">
                        <label asp-for="ReagentConcentrationMolPerL">Reagent Concentration <span class="unit">(mol/L)</span></label>
                        <input asp-for="ReagentConcentrationMolPerL" type="number" step="any" />
                        <span class="field-error">@Html.ValidationMessageFor(m => m.ReagentConcentrationMolPerL)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="InletLiquidDensityKgM3">Liquid Density <span class="unit">(kg/m³)</span></label>
                        <input asp-for="InletLiquidDensityKgM3" type="number" step="any" />
                    </div>
                    <div class="form-group">
                        <label asp-for="InletLiquidViscosityPas">Liquid Viscosity <span class="unit">(Pa·s)</span></label>
                        <input asp-for="InletLiquidViscosityPas" type="number" step="any" />
                    </div>
                    <div class="form-group">
                        <label asp-for="InletLiquidDiffusivityM2S">Liquid Diffusivity <span class="unit">(m²/s)</span></label>
                        <input asp-for="InletLiquidDiffusivityM2S" type="number" step="any" />
                    </div>
                </div>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-header">
                <div class="form-card-icon">
                    <svg viewBox="0 0 16 16"><path d="M8 1v14M1 8h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
                </div>
                <div>
                    <div class="form-card-title">Operating Conditions &amp; Tower</div>
                    <div class="form-card-sub">Temperature, pressure and packing height</div>
                </div>
            </div>
            <div class="form-card-body">
                <div class="fg3">
                    <div class="form-group">
                        <label asp-for="TemperatureC">Temperature <span class="unit">(°C)</span></label>
                        <input asp-for="TemperatureC" type="number" step="any" />
                        <span class="field-error">@Html.ValidationMessageFor(m => m.TemperatureC)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PressureKPa">Pressure <span class="unit">(kPa)</span></label>
                        <input asp-for="PressureKPa" type="number" step="any" />
                        <span class="field-error">@Html.ValidationMessageFor(m => m.PressureKPa)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PackingHeightM">Packing Height <span class="unit">(m)</span></label>
                        <input asp-for="PackingHeightM" type="number" step="any" />
                        <span class="field-error">@Html.ValidationMessageFor(m => m.PackingHeightM)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="TargetRemovalEfficiencyPercent">Target Removal <span class="unit">(%)</span></label>
                        <input asp-for="TargetRemovalEfficiencyPercent" type="number" step="any" />
                        <span class="field-error">@Html.ValidationMessageFor(m => m.TargetRemovalEfficiencyPercent)</span>
                    </div>
                    <div class="form-group check">
                        <label><input type="checkbox" asp-for="IncludeReactiveAbsorption" /> Include reactive absorption</label>
                        <div class="field-hint">Uses Hatta enhancement factor when a rate constant is supplied.</div>
                    </div>
                    <div class="form-group"></div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="ReactionRateConstantS_Inv">Reaction Rate Constant <span class="unit">(s⁻¹, optional)</span></label>
                        <input asp-for="ReactionRateConstantS_Inv" type="number" step="any" placeholder="optional" />
                    </div>
                    <div class="form-group">
                        <label asp-for="BulkReagentConcentrationMolL">Bulk Reagent Concentration <span class="unit">(mol/L, optional)</span></label>
                        <input asp-for="BulkReagentConcentrationMolL" type="number" step="any" placeholder="optional" />
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-save">
                <svg viewBox="0 0 16 16"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z" /></svg>
                Run Calculation
            </button>
            <a asp-action="Index" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>
