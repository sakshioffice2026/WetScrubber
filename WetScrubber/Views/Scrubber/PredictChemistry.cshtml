@model WetScrubber.Models.ChemistryIndexViewModel
@{
    ViewData["Title"] = "Predict Chemistry";
    ViewData["ActivePage"] = "Chemistry";
}

@section Styles {
    <link rel="stylesheet" href="~/css/project.css" />
    <link rel="stylesheet" href="~/css/scrubber.css" />
    <link rel="stylesheet" href="~/css/chemistry.css" />
    <link rel="stylesheet" href="~/css/predict-chemistry.css" />
}

<!-- Breadcrumb -->
<div class="breadcrumb">
    <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
    <svg viewBox="0 0 16 16" width="12" height="12"><path d="M6 4l4 4-4 4" stroke="#ccc" stroke-width="1.5" fill="none" stroke-linecap="round" /></svg>
    <a asp-controller="Scrubber" asp-action="ChemicalReactions">Chemical Reactions</a>
    <svg viewBox="0 0 16 16" width="12" height="12"><path d="M6 4l4 4-4 4" stroke="#ccc" stroke-width="1.5" fill="none" stroke-linecap="round" /></svg>
    <span>Predict Chemistry</span>
</div>

<!-- Intro card -->
<div class="chem-intro-card">
    <div class="chem-intro-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#00d28c" stroke-width="2" stroke-linecap="round">
            <path d="M12 2a4 4 0 014 4c0 1.5-.8 2.4-1.6 3.2C13.6 10 13 10.7 13 12v1h-2v-1c0-1.8 1-2.8 1.8-3.6.7-.7 1.2-1.2 1.2-2.4a2 2 0 10-4 0H8a4 4 0 014-4zM11 15h2v2h-2z" />
        </svg>
    </div>
    <div>
        <div class="chem-intro-title">Chemistry Predictor (experimental)</div>
        <div class="chem-intro-desc">
            Pick a pollutant and a scrubbing liquid that don't yet have a curated
            reaction on file. This calls a standalone prediction service (a
            k-nearest-neighbor estimate today, a trained GNN once there's enough
            curated data) and shows an estimate with a confidence band.
            <strong>Nothing here is saved automatically</strong> — this page is
            for review only, kept separate from the design form until the
            prediction quality has been checked.
        </div>
    </div>
</div>

<!-- Predictor card -->
<div class="predict-card">
    <div class="predict-form-row">
        <div class="predict-field">
            <label for="pollutantSelect">Pollutant</label>
            <select id="pollutantSelect">
                <option value="">Select pollutant…</option>
                @foreach (var pollutant in Model.Pollutants)
                {
                    <option value="@pollutant.Id" data-mw="@pollutant.DefaultMolecularWeight" data-name="@pollutant.DisplayName">
                        @pollutant.DisplayName (@pollutant.Formula)
                    </option>
                }
            </select>
        </div>

        <div class="predict-field">
            <label for="liquidSelect">Scrubbing Liquid</label>
            <select id="liquidSelect">
                <option value="">Select liquid…</option>
                @foreach (var liquid in Model.Liquids.Values)
                {
                    <option value="@liquid.Id" data-name="@liquid.DisplayName">
                        @liquid.DisplayName (@liquid.Formula)
                    </option>
                }
            </select>
        </div>

        <button id="predictBtn" class="btn-predict" disabled>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M8 1v3M8 12v3M1 8h3M12 8h3M3.3 3.3l2.1 2.1M10.6 10.6l2.1 2.1M12.7 3.3l-2.1 2.1M5.4 10.6l-2.1 2.1" /></svg>
            Predict
        </button>
    </div>

    <div id="predictStatus" class="predict-status"></div>

    <div id="predictResult" class="predict-result" style="display:none;">
        <div class="predict-result-header">
            <span class="predict-result-title">Predicted Chemistry</span>
            <span id="confidenceBadge" class="confidence-badge"></span>
        </div>

        <div class="predict-result-grid">
            <div class="predict-stat">
                <div class="predict-stat-label">Henry's Law Constant</div>
                <div id="statHenrys" class="predict-stat-value">—</div>
            </div>
            <div class="predict-stat">
                <div class="predict-stat-label">Max Removal Efficiency</div>
                <div id="statEfficiency" class="predict-stat-value">—</div>
            </div>
            <div class="predict-stat">
                <div class="predict-stat-label">Stoichiometric Ratio</div>
                <div id="statStoich" class="predict-stat-value">—</div>
            </div>
            <div class="predict-stat">
                <div class="predict-stat-label">Operating pH Range</div>
                <div id="statPh" class="predict-stat-value">—</div>
            </div>
        </div>

        <div class="predict-nearest">
            <div class="predict-nearest-label">Based on nearest known reactions:</div>
            <div id="nearestMatches" class="predict-nearest-tags"></div>
        </div>

        <div class="predict-disclaimer">
            This is an advisory estimate only. Review it against engineering
            judgment before relying on it, and promote it into the curated
            Chemical Reactions table only after verification — it is
            <strong>not</strong> saved automatically.
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/predict-chemistry.js"></script>
}
