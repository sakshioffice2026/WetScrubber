@model WetScrubber.Models.DesignDetailViewModel
@*
    Shared action bar: Generate Report → Redesign as per AI narrative → Compare.
    Lives on the Results page so there's a single place for the report/
    revision workflow instead of scattering these buttons across pages.
    Redesign and Compare stay locked until a report exists — there's
    nothing to redesign or compare against otherwise.
*@
<div class="results-data-card" style="margin-bottom:16px;">
    <div class="results-data-header">
        <div class="results-data-title">Report &amp; Redesign</div>
        <div class="results-data-sub">Generate a report, then redesign per its findings or compare with the previous revision.</div>
    </div>

    <div style="display:flex;gap:8px;flex-wrap:wrap;padding:0 22px 18px;">
        <a asp-controller="Report" asp-action="Generate"
           asp-route-designId="@Model.DesignId"
           class="btn-cancel" style="height:36px;padding:0 16px;white-space:nowrap;">
            <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 2h7l3 3v9a1 1 0 01-1 1H3a1 1 0 01-1-1V3a1 1 0 011-1z" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M5 8h6M5 11h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
            @(Model.HasReport ? "View / Update Report" : "Generate Report")
        </a>

        @if (Model.HasReport)
        {
            <form asp-controller="Scrubber" asp-action="CreateRevision"
                  asp-route-id="@Model.DesignId" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-run-calc" style="height:36px;padding:0 16px;white-space:nowrap;">
                    <svg viewBox="0 0 16 16" width="14" height="14"><path d="M12.146.146a.5.5 0 01.708 0l3 3a.5.5 0 010 .708l-10 10a.5.5 0 01-.168.11l-5 2a.5.5 0 01-.65-.65l2-5a.5.5 0 01.11-.168l10-10z" /></svg>
                    Redesign as per AI narrative
                </button>
            </form>

            <a asp-controller="Scrubber" asp-action="Compare"
               asp-route-id="@Model.DesignId"
               class="btn-cancel @(Model.PreviousDesignId.HasValue ? "" : "btn-disabled")"
               style="height:36px;padding:0 16px;white-space:nowrap;"
               title="@(Model.PreviousDesignId.HasValue ? "Compare with the previous revision" : "No previous revision to compare with yet")">
                <svg viewBox="0 0 16 16" width="14" height="14"><path d="M2 2h5v12H2zM9 2h5v12H9z" /></svg>
                Compare with previous
            </a>
        }
        else
        {
            <button type="button" class="btn-cancel btn-disabled" style="height:36px;padding:0 16px;white-space:nowrap;" title="Generate a report first">
                <svg viewBox="0 0 16 16" width="14" height="14"><path d="M12.146.146a.5.5 0 01.708 0l3 3a.5.5 0 010 .708l-10 10a.5.5 0 01-.168.11l-5 2a.5.5 0 01-.65-.65l2-5a.5.5 0 01.11-.168l10-10z" /></svg>
                Redesign as per AI narrative
            </button>
            <button type="button" class="btn-cancel btn-disabled" style="height:36px;padding:0 16px;white-space:nowrap;" title="Generate a report first">
                <svg viewBox="0 0 16 16" width="14" height="14"><path d="M2 2h5v12H2zM9 2h5v12H9z" /></svg>
                Compare with previous
            </button>
        }
    </div>

    @if (!Model.HasReport)
    {
        <div style="padding:0 22px 16px;font-size:12.5px;color:#999;">
            Generate a report first — <strong>Redesign</strong> and <strong>Compare</strong> unlock once one exists.
        </div>
    }
</div>
