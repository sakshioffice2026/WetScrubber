@model WetScrubber.Models.DesignCompareViewModel
@{
    ViewData["Title"] = "Compare Designs";
    ViewData["ActivePage"] = "NewDesign";
}

@section Styles {
    <link rel="stylesheet" href="~/css/project.css" />
    <link rel="stylesheet" href="~/css/scrubber.css" />
    <link rel="stylesheet" href="~/css/results.css" />
    <style>
        .cmp-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12.5px;
        }

            .cmp-table th {
                text-align: left;
                padding: 8px 10px;
                color: #6b7280;
                font-weight: 600;
                border-bottom: 1px solid #e5e7eb;
            }

            .cmp-table td {
                padding: 8px 10px;
                border-bottom: 1px solid #f3f4f6;
            }

        .cmp-up {
            color: #059669;
            font-weight: 600;
        }

        .cmp-down {
            color: #dc2626;
            font-weight: 600;
        }

        .cmp-flat {
            color: #9ca3af;
        }

        .cmp-tag {
            font-size: 10.5px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 999px;
            white-space: nowrap;
        }

        .cmp-tag-good {
            background: #d1fae5;
            color: #065f46;
        }

        .cmp-tag-bad {
            background: #fee2e2;
            color: #991b1b;
        }

        .report-narrative-body {
            padding: 18px 22px;
            white-space: pre-wrap;
            font-size: 13px;
            line-height: 1.6;
            color: #333;
            max-height: 380px;
            overflow-y: auto;
        }

        .report-warning {
            border-radius: 8px;
            padding: 12px 16px;
            font-size: 12.5px;
            margin-bottom: 16px;
        }
    </style>
}

@section TopbarActions {
    <a asp-controller="Scrubber" asp-action="DesignDetail" asp-route-id="@Model.NewDesignId"
       class="btn-cancel" style="height:34px;padding:0 14px;font-size:12.5px;display:flex;align-items:center;">
        ← Back to Design
    </a>
}

<div class="results-header-card">
    <div class="results-header-left">
        <div class="results-badge-type">Redesign Comparison</div>
        <div class="results-title">@Model.OldDesignName → @Model.NewDesignName</div>
        <div class="results-subtitle">
            Revision @Model.NewRevisionNumber &nbsp;·&nbsp; This revision's report status: @Model.NewReportStatus
        </div>
    </div>
</div>

<!-- ── Field-by-field diff ───────────────────────────────────── -->
<div class="results-data-card" style="margin-bottom:16px;">
    <div class="results-data-header">
        <div class="results-data-title">Inputs &amp; results</div>
        <div class="results-data-sub">Old (locked) vs. this revision — the "addressed" tag only appears where the original design had a finding on that field</div>
    </div>
    <div style="padding:6px 10px 16px;overflow-x:auto;">
        <table class="cmp-table">
            <thead>
                <tr>
                    <th>Field</th>
                    <th>Old</th>
                    <th>New</th>
                    <th>Change</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var deltaClass = row.Delta > 0 ? "cmp-up" : row.Delta < 0 ? "cmp-down" : "cmp-flat";
                    var arrow = row.Delta > 0 ? "▲" : row.Delta < 0 ? "▼" : "–";
                    <tr>
                        <td>@row.Label</td>
                        <td>@row.OldValue.ToString("N2") @row.Unit</td>
                        <td>@row.NewValue.ToString("N2") @row.Unit</td>
                        <td class="@deltaClass">
                            @arrow @Math.Abs(row.Delta).ToString("N2")
                            @if (row.DeltaPercent.HasValue)
                            {
                                <span class="cmp-flat">(@row.DeltaPercent.Value.ToString("+0.0;-0.0")%)</span>
                            }
                        </td>
                        <td>
                            @if (row.MatchesRecommendation == true)
                            {
                                <span class="cmp-tag cmp-tag-good">Addressed</span>
                            }
                            else if (row.MatchesRecommendation == false)
                            {
                                <span class="cmp-tag cmp-tag-bad">Still short</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ── Remaining findings on the revision ────────────────────── -->
@if (Model.NewDiagnostics.Any())
{
    <div class="report-warning" style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;">
        This revision still has @Model.NewDiagnostics.Count open finding@(Model.NewDiagnostics.Count == 1 ? "" : "s"):
        <ul style="margin:8px 0 0;padding-left:18px;">
            @foreach (var f in Model.NewDiagnostics)
            {
                <li>@f.Symptom @f.Recommendation</li>
            }
        </ul>
    </div>
}
else
{
    <div class="report-warning" style="background:#f0fdf8;border:1px solid #bbf7e0;color:#065f46;">
        No open findings on this revision — the last calculation cleared every check.
    </div>
}

<!-- ── Narratives, side by side — never merged ───────────────── -->
<div class="report-two-col" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="results-data-card">
        <div class="results-data-header">
            <div class="results-data-title">Original — report narrative</div>
            <div class="results-data-sub">From the original design's report</div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.OldApprovedNarrative))
        {
            <div class="report-narrative-body">@Model.OldApprovedNarrative</div>
        }
        else
        {
            <div class="report-ai-empty" style="padding:0 22px 18px;font-size:12.5px;color:#999;">No report generated on the original.</div>
        }
    </div>

    <div class="results-data-card">
        <div class="results-data-header">
            <div class="results-data-title">Revision @Model.NewRevisionNumber — report narrative</div>
            <div class="results-data-sub">@(string.IsNullOrWhiteSpace(Model.NewAiNarrative) ? "Template only — no AI draft yet" : "AI-drafted")</div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.NewApprovedNarrative))
        {
            <div class="report-narrative-body">@Model.NewApprovedNarrative</div>
        }
        else
        {
            <div class="report-ai-empty" style="padding:0 22px 18px;font-size:12.5px;color:#999;">
                No narrative yet on this revision —
                <a asp-controller="Report" asp-action="Generate" asp-route-designId="@Model.NewDesignId">generate a report</a> once it's recalculated.
            </div>
        }
    </div>
</div>
