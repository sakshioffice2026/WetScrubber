
@using WetScrubber.Database.Enums
@model WetScrubber.Models.CreateDesignViewModel

@{
    ViewData["Title"] = "New Design";
    ViewData["ActivePage"] = "NewDesign";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-grid.min.css" />
    <link rel="stylesheet" href="~/css/project.css" />
    <link rel="stylesheet" href="~/css/scrubber.css" />
}

@section TopbarActions {
    <a asp-controller="Project" asp-action="Detail"
       asp-route-id="@Model.ProjectId"
       class="btn-cancel"
       style="height:34px;padding:0 14px;font-size:12.5px;display:flex;align-items:center;">
        ← Back to Project
    </a>
}

<div class="breadcrumb">
    <a asp-controller="Project" asp-action="Index">Projects</a>
    <svg viewBox="0 0 16 16">
        <path d="M6 4l4 4-4 4" stroke="#ccc" stroke-width="1.5" fill="none" stroke-linecap="round" />
    </svg>
    <a asp-controller="Project" asp-action="Detail" asp-route-id="@Model.ProjectId">@Model.ProjectNumber</a>
    <svg viewBox="0 0 16 16">
        <path d="M6 4l4 4-4 4" stroke="#ccc" stroke-width="1.5" fill="none" stroke-linecap="round" />
    </svg>
    <span>New Design</span>
</div>
<div class="create-wizard">

<div class="steps-bar">
    <div class="step-item active" data-target="#sec-type" role="button" tabindex="0">
        <div class="step-num">1</div>
        <div>
            <div class="step-label">Type &amp; Name</div>
            <div class="step-sub">Scrubber selection</div>
        </div>
    </div>
    <div class="step-item" data-target="#sec-gas" role="button" tabindex="0">
        <div class="step-num">2</div>
        <div>
            <div class="step-label">Gas &amp; Pollutants</div>
            <div class="step-sub">Flow &amp; concentrations</div>
        </div>
    </div>
    <div class="step-item" data-target="#sec-liquid" role="button" tabindex="0">
        <div class="step-num">3</div>
        <div>
            <div class="step-label">Liquid Specs</div>
            <div class="step-sub">Scrubbing liquid</div>
        </div>
    </div>
    <div class="step-item" data-target="#sec-materials" role="button" tabindex="0">
        <div class="step-num">4</div>
        <div>
            <div class="step-label">Materials</div>
            <div class="step-sub">Construction</div>
        </div>
    </div>
</div>

<form asp-action="Create" asp-controller="Scrubber" method="post" id="designForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All"
         class="field-error"
         role="alert"
         style="display:block; margin-bottom:16px;">
    </div>

    <input type="hidden" asp-for="ProjectId" />
    <input type="hidden" asp-for="ProjectNumber" />
    <input type="hidden" asp-for="ProjectName" />

    <!-- ═══ CONTAINER 1 — Steps 1 & 2 ═══ -->
    <div class="form-card wizard-card">

        <!-- STEP 1 -->
        <div class="step-block" id="sec-type">
            <div class="step-heading"><span class="step-badge">Step 1</span> Type &amp; Name</div>
                <div class="fg2">
                    <div class="form-group">
                        <label asp-for="DesignName">Design Name <span class="req">*</span></label>
                        <input asp-for="DesignName"
                               id="DesignName"
                               class="@(ViewData.ModelState["DesignName"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               placeholder="e.g. Packed Tower Design A"
                               autofocus />
                        <span class="field-error">@Html.ValidationMessageFor(m => m.DesignName)</span>
                    </div>

                    <div class="form-group">
                        <label for="ScrubberType">Scrubber Type <span class="req">*</span></label>
                        <select name="ScrubberType" id="ScrubberType">
                            <option value="1" selected="@(Model.ScrubberType == ScrubberType.PackedTower ? "selected" : null)">Packed Tower — gas absorption &amp; SO₂/HCl removal</option>
                            <option value="2" selected="@(Model.ScrubberType == ScrubberType.VenturiScrubber ? "selected" : null)">Venturi Scrubber — particles &amp; sticky gases</option>
                            <option value="3" selected="@(Model.ScrubberType == ScrubberType.SprayTower ? "selected" : null)">Spray Tower — low pressure drop, easy maintenance</option>
                            <option value="4" selected="@(Model.ScrubberType == ScrubberType.WetCyclone ? "selected" : null)">Wet Cyclone — centrifugal separation, large particles</option>
                            <option value="5" selected="@(Model.ScrubberType == ScrubberType.JetEjectorScrubber ? "selected" : null)">Jet Ejector — no moving parts, corrosive gases</option>
                            <option value="6" selected="@(Model.ScrubberType == ScrubberType.ImpingementPlate ? "selected" : null)">Impingement Plate — multi-stage plate column</option>
                        </select>
                        <span class="field-error">@Html.ValidationMessageFor(m => m.ScrubberType)</span>
                    </div>
                </div>
        </div>

        <!-- STEP 2 -->
        <div class="step-block" id="sec-gas">
            <div class="step-heading"><span class="step-badge">Step 2</span> Gas Stream &amp; Pollutants</div>
        <div class="row gas-pollutant-container">
            <div class="col-lg-6 gp-col">
                <div class="gp-panel">
                    <div class="gp-panel-body">
                        <div class="card-title-sm">Gas Stream</div>
                        <div class="fg2">
                            <div class="form-group">
                                <label asp-for="NormalFlowRate">Normal Flow Rate <span class="req">*</span></label>
                                <div class="input-unit">
                                    <input asp-for="NormalFlowRate" id="NormalFlowRate" type="number" step="any"
                                           class="@(ViewData.ModelState["NormalFlowRate"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                           placeholder="5000" />
                                    <span class="unit-badge">Nm³/hr</span>
                                </div>
                                <span class="field-error">@Html.ValidationMessageFor(m => m.NormalFlowRate)</span>
                            </div>

                            <div class="form-group">
                                <label asp-for="ActualFlowRate">Actual Flow Rate <span class="req">*</span></label>
                                <div class="input-unit">
                                    <input asp-for="ActualFlowRate" id="ActualFlowRate" type="number" step="any"
                                           class="@(ViewData.ModelState["ActualFlowRate"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                           placeholder="5800" />
                                    <span class="unit-badge">m³/hr</span>
                                </div>
                                <span class="field-error">@Html.ValidationMessageFor(m => m.ActualFlowRate)</span>
                            </div>

                            <div class="form-group">
                                <label asp-for="InletTemperature">Inlet Temperature <span class="req">*</span></label>
                                <div class="input-unit">
                                    <input asp-for="InletTemperature" id="InletTemperature" type="number" step="any"
                                           class="@(ViewData.ModelState["InletTemperature"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                           placeholder="150" />
                                    <span class="unit-badge">°C</span>
                                </div>
                                <span class="field-error">@Html.ValidationMessageFor(m => m.InletTemperature)</span>
                            </div>

                            <div class="form-group">
                                <label asp-for="InletPressure">Inlet Pressure</label>
                                <div class="input-unit">
                                    <input asp-for="InletPressure" type="number" step="any"
                                           class="@(ViewData.ModelState["InletPressure"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                           placeholder="101325" />
                                    <span class="unit-badge">Pa</span>
                                </div>
                                <span class="field-error">@Html.ValidationMessageFor(m => m.InletPressure)</span>
                            </div>

                            <div class="form-group">
                                <label asp-for="MoistureContent">Moisture Content</label>
                                <div class="input-unit">
                                    <input asp-for="MoistureContent" type="number" step="any" placeholder="8" />
                                    <span class="unit-badge">% vol</span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="GasDensity">Gas Density</label>
                                <div class="input-unit">
                                    <input asp-for="GasDensity" type="number" step="any" placeholder="1.18" />
                                    <span class="unit-badge">kg/m³</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 gp-col">
                <div class="gp-panel">
                    <div class="gp-panel-body">
                        <div class="card-title-sm">Pollutant Targets</div>
                        <div class="pollutant-scroll">
                            <div class="pollutant-table-head">
                                <span>Pollutant</span>
                                <span>Inlet (mg/Nm³)</span>
                                <span>Target Outlet</span>
                                <span>Removal %</span>
                                <span>Mol. Wt</span>
                                <span></span>
                            </div>

            <div id="pollutantContainer">
                @for (int i = 0; i < Model.Pollutants.Count; i++)
                {
                    <div class="pollutant-row">
                        <div class="form-group">
                            <label>Pollutant</label>
                            <select name="Pollutants[@i].PollutantType">
                                @foreach (var opt in Model.PollutantOptions)
                                {
                                    <option value="@opt.Id" selected="@(Model.Pollutants[i].PollutantType == opt.Id ? "selected" : null)">
                                        @Html.Raw(opt.Formula)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Inlet (mg/Nm³)</label>
                            <input type="number"
                                   step="any"
                                   name="Pollutants[@i].InletConcentration"
                                   value="@Model.Pollutants[i].InletConcentration"
                                   class="inlet-conc"
                                   placeholder="1000" />
                        </div>

                        <div class="form-group">
                            <label>Target Outlet</label>
                            <input type="number"
                                   step="any"
                                   name="Pollutants[@i].TargetOutletConcentration"
                                   value="@Model.Pollutants[i].TargetOutletConcentration"
                                   class="outlet-conc"
                                   placeholder="50" />
                        </div>

                        <div class="form-group">
                            <label>Removal %</label>
                            <input type="number"
                                   step="any"
                                   name="Pollutants[@i].TargetRemovalEfficiency"
                                   value="@Model.Pollutants[i].TargetRemovalEfficiency"
                                   class="removal-eff"
                                   placeholder="95" />
                        </div>

                        <div class="form-group">
                            <label>Mol. Weight</label>
                            <input type="number"
                                   step="any"
                                   name="Pollutants[@i].MolecularWeight"
                                   value="@Model.Pollutants[i].MolecularWeight"
                                   placeholder="64" />
                        </div>

                        <button type="button" class="btn-remove-pollutant" title="Remove row">
                            <svg viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 016 6v6a.5.5 0 01-1 0V6a.5.5 0 01.5-.5zm2.5 0a.5.5 0 01.5.5v6a.5.5 0 01-1 0V6a.5.5 0 01.5-.5zm3 .5a.5.5 0 00-1 0v6a.5.5 0 011 0V6zM14.5 3a1 1 0 01-1 1H13v9a2 2 0 01-2 2H5a2 2 0 01-2-2V4h-.5a1 1 0 010-2h4a1 1 0 011-1h2a1 1 0 011 1h4a1 1 0 011 1z" />
                            </svg>
                        </button>
                    </div>
                }
            </div>
                        </div>

            <button type="button" class="btn-add-pollutant" id="btnAddPollutant">
                <svg viewBox="0 0 16 16"><path d="M8 1v14M1 8h14" /></svg>
                Add another pollutant
            </button>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </div>

    <!-- ═══ CONTAINER 2 — Steps 3 & 4 ═══ -->
    <div class="form-card wizard-card">

        <!-- STEP 3 -->
        <div class="step-block" id="sec-liquid">
            <div class="step-heading"><span class="step-badge">Step 3</span> Liquid Specs</div>
            <!-- Row 1 — Primary liquid parameters -->
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="LiquidType">Liquid Type <span class="req">*</span></label>
                        <select name="LiquidType" id="LiquidType">
                            @foreach (var opt in Model.LiquidOptions)
                            {
                                <option value="@opt.Id" selected="@(Model.LiquidType == opt.Id ? "selected" : null)">
                                    @opt.DisplayName@(string.IsNullOrEmpty(opt.Formula) ? "" : " (" + opt.Formula + ")")
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="LiquidConcentration">Concentration</label>
                        <div class="input-unit">
                            <input asp-for="LiquidConcentration" type="number" step="any" placeholder="10" />
                            <span class="unit-badge">% wt</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="LiquidPH">pH</label>
                        <input asp-for="LiquidPH" type="number" step="0.1" placeholder="12" />
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="LiquidTemperature">Temperature</label>
                        <div class="input-unit">
                            <input asp-for="LiquidTemperature" type="number" step="any" placeholder="25" />
                            <span class="unit-badge">°C</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="LiquidDensity">Density</label>
                        <div class="input-unit">
                            <input asp-for="LiquidDensity" type="number" step="any" placeholder="1050" />
                            <span class="unit-badge">kg/m³</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Row 2 — Process & slurry parameters -->
            <div class="row g-3 liquid-row-2">
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="LiquidToGasRatio">L/G Ratio <span class="req">*</span></label>
                        <div class="input-unit">
                            <input asp-for="LiquidToGasRatio" type="number" step="any" placeholder="3.0" />
                            <span class="unit-badge">L/m³ gas</span>
                        </div>
                        <span class="field-hint" id="lgRatioHint">Packed Tower: recommended 2–10 L/m³</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label class="label-spacer">&nbsp;</label>
                        <div class="check-wrap">
                            <label class="check-inline">
                                <input asp-for="IsLimestoneSlurry" id="IsLimestoneSlurry" />
                                Limestone FGD slurry
                            </label>
                            <span class="info-tip" tabindex="0"
                                  data-tip="Applies slurry density and apparent-viscosity corrections to hydraulic calculations.">i</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 slurry-fields" id="slurryFields">
                    <div class="slurry-card">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="form-group">
                                    <label asp-for="SolidsLoadingWtPercent">Limestone Solids</label>
                                    <div class="input-unit">
                                        <input asp-for="SolidsLoadingWtPercent" type="number" step="0.1" placeholder="15" />
                                        <span class="unit-badge">wt%</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="form-group">
                                    <label asp-for="LimestoneParticleDiameterMicron">Particle Size</label>
                                    <div class="input-unit">
                                        <input asp-for="LimestoneParticleDiameterMicron" type="number" step="1" placeholder="50" />
                                        <span class="unit-badge">micron</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- STEP 4 -->
        <div class="step-block" id="sec-materials">
            <div class="step-heading"><span class="step-badge">Step 4</span> Materials &amp; Construction</div>
            <div class="fg-auto">
                <div class="form-group">
                    <label for="ShellMaterial">Shell Material</label>
                    <select name="ShellMaterial" id="ShellMaterial">
                        <option value="1" selected="@(Model.ShellMaterial == ConstructionMaterial.FRP ? "selected" : null)">FRP — Fibre Reinforced Plastic</option>
                        <option value="2" selected="@(Model.ShellMaterial == ConstructionMaterial.PP ? "selected" : null)">PP — Polypropylene</option>
                        <option value="5" selected="@(Model.ShellMaterial == ConstructionMaterial.SS316 ? "selected" : null)">SS 316 — Stainless Steel</option>
                        <option value="3" selected="@(Model.ShellMaterial == ConstructionMaterial.HDPE ? "selected" : null)">HDPE — High Density PE</option>
                        <option value="4" selected="@(Model.ShellMaterial == ConstructionMaterial.PVC ? "selected" : null)">PVC — Polyvinyl Chloride</option>
                        <option value="6" selected="@(Model.ShellMaterial == ConstructionMaterial.HastelloyC ? "selected" : null)">Hastelloy C — High Alloy</option>
                        <option value="7" selected="@(Model.ShellMaterial == ConstructionMaterial.CarbonSteel ? "selected" : null)">Carbon Steel — With lining</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="PackingCode">Packing Type</label>
                    <select name="PackingCode"
                            id="PackingCode"
                            class="@(ViewData.ModelState["PackingCode"]?.Errors.Count > 0 ? "is-invalid" : "")">
                        <option value="">-- Default (Pall Ring 50mm) --</option>
                        @foreach (var opt in Model.PackingOptions)
                        {
                            <option value="@opt.Code" selected="@(Model.PackingCode == opt.Code ? "selected" : null)">
                                @opt.DisplayName
                            </option>
                        }
                    </select>
                    <span class="field-error">@Html.ValidationMessageFor(m => m.PackingCode)</span>
                    <span class="field-hint">Only used for Packed Tower sizing; ignored for other scrubber types.</span>
                </div>

                <div class="form-group">
                    <label for="InternalMaterial">Internal Material</label>
                    <select name="InternalMaterial" id="InternalMaterial">
                        <option value="1" selected="@(Model.InternalMaterial == ConstructionMaterial.FRP ? "selected" : null)">FRP — Fibre Reinforced Plastic</option>
                        <option value="2" selected="@(Model.InternalMaterial == ConstructionMaterial.PP ? "selected" : null)">PP — Polypropylene</option>
                        <option value="5" selected="@(Model.InternalMaterial == ConstructionMaterial.SS316 ? "selected" : null)">SS 316 — Stainless Steel</option>
                        <option value="3" selected="@(Model.InternalMaterial == ConstructionMaterial.HDPE ? "selected" : null)">HDPE — High Density PE</option>
                        <option value="4" selected="@(Model.InternalMaterial == ConstructionMaterial.PVC ? "selected" : null)">PVC — Polyvinyl Chloride</option>
                        <option value="6" selected="@(Model.InternalMaterial == ConstructionMaterial.HastelloyC ? "selected" : null)">Hastelloy C — High Alloy</option>
                        <option value="7" selected="@(Model.InternalMaterial == ConstructionMaterial.CarbonSteel ? "selected" : null)">Carbon Steel — With lining</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer action bar -->
    <div class="wizard-footer">
        <a asp-controller="Project" asp-action="Detail" asp-route-id="@Model.ProjectId" class="btn-wiz">Cancel</a>
        <button type="submit" class="btn-wiz primary" id="btnSave">Save Design</button>
    </div>
</form>
</div>


<template id="pollutantRowTemplate">
    <div class="pollutant-row">
        <div class="form-group">
            <label>Pollutant</label>
            <select name="Pollutants[INDEX].PollutantType">
                @foreach (var opt in Model.PollutantOptions)
                {
                    <option value="@opt.Id">@Html.Raw(opt.Formula)</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Inlet (mg/Nm³)</label>
            <input type="number"
                   step="any"
                   name="Pollutants[INDEX].InletConcentration"
                   class="inlet-conc"
                   placeholder="1000" />
        </div>

        <div class="form-group">
            <label>Target Outlet</label>
            <input type="number"
                   step="any"
                   name="Pollutants[INDEX].TargetOutletConcentration"
                   class="outlet-conc"
                   placeholder="50" />
        </div>

        <div class="form-group">
            <label>Removal %</label>
            <input type="number"
                   step="any"
                   name="Pollutants[INDEX].TargetRemovalEfficiency"
                   class="removal-eff"
                   placeholder="95" />
        </div>

        <div class="form-group">
            <label>Mol. Weight</label>
            <input type="number"
                   step="any"
                   name="Pollutants[INDEX].MolecularWeight"
                   placeholder="64" />
        </div>

        <button type="button" class="btn-remove-pollutant" title="Remove row">
            <svg viewBox="0 0 16 16">
                <path d="M5.5 5.5A.5.5 0 016 6v6a.5.5 0 01-1 0V6a.5.5 0 01.5-.5zm2.5 0a.5.5 0 01.5.5v6a.5.5 0 01-1 0V6a.5.5 0 01.5-.5zm3 .5a.5.5 0 00-1 0v6a.5.5 0 011 0V6z" />
            </svg>
        </button>
    </div>
</template>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/scrubber.js"></script>
    <script src="~/js/stepper.js"></script>
    <script>
        $(function () {
            var hints = {
                '1': 'Packed Tower: recommended 2–10 L/m³',
                '2': 'Venturi: recommended 0.5–3 L/m³',
                '3': 'Spray Tower: recommended 1–3 L/m³'
            };
            function updateHint() {
                $('#lgRatioHint').text(hints[$('#ScrubberType').val()] || 'Typical range: 1–5 L/m³');
            }
            $('#ScrubberType').on('change', updateHint);
            updateHint();

            function toggleSlurry() {
                $("#slurryFields").toggle($("#IsLimestoneSlurry").is(":checked"));
            }
            $("#IsLimestoneSlurry").on("change", toggleSlurry);
            toggleSlurry();
        });
    </script>
}
